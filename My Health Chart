      const tempCanvas = document.getElementById('print-chart-temp');
      if(tempCanvas){
        new Chart(tempCanvas, { type:'line', data:{ labels, datasets:[{ label:'Temp °F', data:v.map(x=>x.temp), borderColor:'#f59e0b', tension:.3, pointRadius:2 }] }, options: Object.assign({}, commonOpts, {plugins:{legend:{display:false}}}) });
      }
    },
    healthReportHTML(includeRides, includeScreenings){
      const p = App.state.profile, v = this.reportVitals(), win = this._reportWindow;
      const visitDateInput = document.getElementById('report-visit-date-input');
      const today = visitDateInput && visitDateInput.value ? App.formatDate(visitDateInput.value) : App.formatDate(new Date().toISOString().split('T')[0]);
      const recentV = win ? v.slice() : v.slice(0,15);
      // Detailed Readings: when printing a 7-day window, every day in the
      // window gets a row. A day with no vitals logged shows "Not Entered";
      // a day with several readings shows each one.
      let tableRows = recentV;
      if(win){
        tableRows = [];
        const d = new Date(win.start+'T00:00:00');
        for(let i=1;i<=7;i++){
          const ds = this.localISO(d);
          const dayReadings = recentV.filter(r=>r.date===ds).sort((a,b)=>String(a.time||'').localeCompare(String(b.time||'')));
