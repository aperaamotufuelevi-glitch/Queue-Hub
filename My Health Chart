    // size:auto, i.e. whatever paper size is set in the print dialog/OS,
    // normally Letter or A4) with a max-width matching a Letter page so the
    // layout doesn't sprawl wider than a normal printed sheet.
    printDashboard(){
      const p = App.state.profile;
      const last = App.state.vitals[0];
      const bpStatus = last ? (last.systolic>=140||last.diastolic>=90 ? 'High' : (last.systolic>=130||last.diastolic>=80 ? 'Elevated' : 'Normal')) : '--';
      const fullName = `${p.firstName} ${p.lastName}`.trim() || 'Health Vault User';
      const today = new Date(); today.setHours(0,0,0,0);
      const needsRefill = App.state.medications
        .filter(m=>!!(m.nextRefillDate||m.refillDate))
        .sort((a,b)=> new Date((a.nextRefillDate||a.refillDate)+'T00:00:00') - new Date((b.nextRefillDate||b.refillDate)+'T00:00:00'))
        .slice(0,6);
      const todayStr = new Date().toISOString().split('T')[0];
      const upcoming = App.state.rides.filter(r=>r.apptDate>=todayStr && r.status!=='cancelled').sort((a,b)=>a.apptDate.localeCompare(b.apptDate)).slice(0,5);
      const recentV = App.state.vitals.slice(0,6);

      const html = this.printPageHTML(`<div style="padding:18px;box-sizing:border-box;max-width:8.5in;margin:0 auto;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #2563eb;padding-bottom:10px;margin-bottom:14px;">
          <div><h1 style="font-size:20px;font-weight:900;color:#1e3a8a;text-transform:uppercase;margin:0;">Dashboard Snapshot</h1><p style="font-size:11px;color:#64748b;margin:2px 0 0 0;">${fullName} • ${new Date().toLocaleDateString()}</p></div>
          <div style="padding:4px 8px;border:1px solid #e2e8f0;border-radius:6px;">${this.freshBarcodeBlock('DASH')}</div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;">
          <div style="border:1px solid #fecaca;background:#fef2f2;border-radius:10px;padding:10px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#ef4444;text-transform:uppercase;margin:0;">Blood Pressure</p><p style="font-size:18px;font-weight:900;margin:2px 0 0 0;">${last?last.systolic+'/'+last.diastolic:'--/--'}</p><p style="font-size:9px;color:#64748b;margin:0;">${bpStatus}</p></div>
          <div style="border:1px solid #a5f3fc;background:#ecfeff;border-radius:10px;padding:10px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#06b6d4;text-transform:uppercase;margin:0;">Oxygen (SpO2)</p><p style="font-size:18px;font-weight:900;margin:2px 0 0 0;">${last?last.spo2+'%':'--%'}</p></div>
          <div style="border:1px solid #fde68a;background:#fffbeb;border-radius:10px;padding:10px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#f59e0b;text-transform:uppercase;margin:0;">Body Temp</p><p style="font-size:18px;font-weight:900;margin:2px 0 0 0;">${last?last.temp+'°F':'--°F'}</p></div>
          <div style="border:1px solid #c7d2fe;background:#eef2ff;border-radius:10px;padding:10px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#6366f1;text-transform:uppercase;margin:0;">BMI</p><p style="font-size:18px;font-weight:900;margin:2px 0 0 0;">${p.bmi?p.bmi.toFixed(1):'--'}</p></div>
        </div>
        <div style="border:1px solid #e2e8f0;border-radius:8px;padding:10px;margin-bottom:14px;">
          <h3 style="font-size:11px;font-weight:700;margin:0 0 6px 0;text-transform:uppercase;color:#475569;">Vital Trends (Recent)</h3>
          <canvas id="print-dash-chart" width="700" height="180"></canvas>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div>
            <h3 style="font-size:11px;font-weight:700;margin:0 0 6px 0;text-transform:uppercase;color:#475569;">Recent Readings</h3>
            <table style="width:100%;border-collapse:collapse;font-size:9px;"><thead><tr style="background:#f1f5f9;"><th style="padding:4px;text-align:left;color:#1a1a1a;">Date</th><th style="padding:4px;text-align:center;color:#1a1a1a;">BP</th><th style="padding:4px;text-align:center;color:#1a1a1a;">HR/SpO2</th><th style="padding:4px;text-align:center;color:#1a1a1a;">Temp</th></tr></thead><tbody>
              ${recentV.length? recentV.map(v=>`<tr><td style="padding:4px;border-bottom:1px solid #e2e8f0;"><div>${App.formatDateShort(v.date)}</div><div style="font-size:7px;color:#94a3b8;text-transform:uppercase;">${App.formatTime(v.time)}</div></td><td style="padding:4px;border-bottom:1px solid #e2e8f0;text-align:center;">${v.systolic}/${v.diastolic}</td><td style="padding:4px;border-bottom:1px solid #e2e8f0;text-align:center;">${v.heartRate}/${v.spo2}%</td><td style="padding:4px;border-bottom:1px solid #e2e8f0;text-align:center;">${v.temp}°F</td></tr>`).join('') : '<tr><td colspan="4" style="padding:6px;text-align:center;color:#94a3b8;">No readings logged.</td></tr>'}
            </tbody></table>
