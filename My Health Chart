    selectOption(btn){
      const block = btn.closest('.sb-question-block'); const qId = block.dataset.q; const score = parseInt(btn.dataset.score);
      block.querySelectorAll('.sb-option-btn').forEach(b=>b.classList.remove('selected'));
      btn.classList.add('selected'); this.answers[qId] = score;
      block.classList.remove('sb-unanswered'); block.classList.add('sb-answered');
      this.updateProgress(); this.autoCalculateSection(qId);
    },
    updateProgress(){
      const total = 37; const answered = Object.keys(this.answers).length;
      const pct = Math.round((answered/total)*100);
      document.getElementById('progressFill').style.width = pct+'%';
      document.getElementById('progressText').innerText = answered+' of '+total+' questions answered';
    },
    autoCalculateSection(qId){
      if(qId.startsWith('audit')) this.calculateAudit();
      if(qId.startsWith('dast')) this.calculateDast();
      if(qId.startsWith('phq')) this.calculatePhq();
      if(qId.startsWith('gad')) this.calculateGad();
    },
    getSectionAnswers(prefix, count){
      let sum=0, answered=0;
      for(let i=1;i<=count;i++){ const key=prefix+'-'+i; if(this.answers[key]!==undefined){ sum+=this.answers[key]; answered++; } }
      return { sum, answered, complete: answered===count };
    },
    scoreLabel(type, score){
      score = Number(score)||0;
      if(type==='audit'){
        if(score===0) return 'No problems reported';
        if(score<=7) return 'Low risk';
        if(score<=15) return 'Moderate risk';
        if(score<=19) return 'High risk';
        return 'Substantial risk';
      }
      if(type==='dast'){
        if(score===0) return 'No problems reported';
        if(score<=2) return 'Moderate level';
        if(score<=5) return 'High level';
        return 'Substantial level';
      }
      if(type==='phq'){
        if(score<=4) return 'Minimal';
        if(score<=9) return 'Mild';
        if(score<=14) return 'Moderate';
        if(score<=19) return 'Moderately severe';
        return 'Severe';
      }
      if(type==='gad'){
        if(score<=4) return 'Minimal';
        if(score<=9) return 'Mild';
        if(score<=14) return 'Moderate';
        return 'Severe';
      }
      return '';
    },
    scoreDetail(type, score){
      score = Number(score)||0;
      if(type==='audit'){
        if(score===0) return {risk:'No problems reported', action:'Encouragement and education'};
        if(score<=7) return {risk:'Low risk', action:'Alcohol education'};
        if(score<=15) return {risk:'Moderate risk', action:'Brief intervention'};
        if(score<=19) return {risk:'High risk', action:'Brief intervention plus brief counseling'};
        return {risk:'Substantial risk', action:'Brief intervention plus referral to specialized treatment'};
      }
      if(type==='dast'){
        if(score===0) return {risk:'No problems reported', action:'Encouragement and education'};
        if(score<=2) return {risk:'Moderate level', action:'Brief intervention'};
        if(score<=5) return {risk:'High level', action:'Brief intervention plus brief therapy'};
        return {risk:'Substantial level', action:'Brief intervention plus referral to chemical dependency treatment'};
      }
      if(type==='phq'){
        if(score<=4) return {risk:'Minimal depression', action:'None needed — monitor'};
        if(score<=9) return {risk:'Mild depression', action:'Watchful waiting; repeat PHQ-9 at follow-up'};
        if(score<=14) return {risk:'Moderate depression', action:'Treatment plan; consider counseling and/or medication'};
        if(score<=19) return {risk:'Moderately severe depression', action:'Active treatment with medication and/or psychotherapy'};
        return {risk:'Severe depression', action:'Immediate initiation of medication and/or psychotherapy; consider hospitalization if severe impairment or suicidal ideation'};
      }
      if(type==='gad'){
        if(score<=4) return {risk:'Minimal anxiety', action:'None needed — monitor'};
        if(score<=9) return {risk:'Mild anxiety', action:'Watchful waiting; repeat GAD-7 at follow-up'};
        if(score<=14) return {risk:'Moderate anxiety', action:'Treatment plan; consider counseling and/or medication'};
        return {risk:'Severe anxiety', action:'Active treatment with medication and/or psychotherapy'};
