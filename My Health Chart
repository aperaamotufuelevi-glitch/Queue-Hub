/* ============================================================
   PersistentStore
   ------------------------------------------------------------
   Root cause of "doctors won't save": this app previously used
   only window.localStorage. When this file is opened inside a
   sandboxed preview (e.g. an in-chat artifact viewer), browsers
   block localStorage for that origin, so every save silently
   fails (or falls back to an in-memory store that's wiped on
   refresh) - it LOOKS like data saved (toast still fires) but
   it's gone on reload. That's exactly what "not saved in my
   personal storage" describes.

   Fix: prefer the platform's persistent key/value storage
   (window.storage, exposed to artifacts) when it's available,
   since it actually survives reloads/sessions. If it's not
   available (e.g. you downloaded this file and opened it
   directly in a normal browser tab), fall back to localStorage,
   and if THAT'S blocked too, fall back to in-memory with a
   visible warning toast so you're never silently losing data.

   IMPORTANT (fix for "I cannot save any changes at all"): the
   ORIGINAL version of this object computed `useRemote` exactly
   ONCE, as a plain boolean, at the moment this <script> block
   first ran:
       useRemote: (typeof window !== 'undefined' && !!window.storage && ...)
   On some hosts, the platform injects `window.storage` into the
   page AFTER this script has already started executing (it is
   not guaranteed to exist at parse time). When that happens the
   one-time check above runs too early, sees no `window.storage`
   yet, and permanently decides `useRemote = false` for the rest
   of the page's life - even though `window.storage` shows up a
   moment later. Every single save/load for the rest of the
   session then goes to localStorage (or its in-memory fallback)
   instead of the real persistent store, which is exactly the
   "nothing I do ever saves" symptom, since a fresh page load
   (a new preview, a new tab, a shared/synced view) never sees
   those localStorage-only writes.

   Fix: `useRemote` is now a getter that re-checks
   `typeof window.storage !== 'undefined'` on every single call
   instead of a value cached once at load. This makes storage
   selection correct no matter when the host attaches
   window.storage relative to this script running.
   ============================================================ */
const PersistentStore = {
  get useRemote(){
    return (typeof window !== 'undefined' && !!window.storage && typeof window.storage.get === 'function' && typeof window.storage.set === 'function');
  },
  async get(key){
    if(this.useRemote){
      try{
        const res = await window.storage.get(key, false);
        return (res && typeof res.value === 'string') ? res.value : null;
      } catch(e){
        // Tool throws on missing keys - treat as "not found", not a hard failure.
        return null;
      }
    }
    return safeStorage.getItem(key);
  },
  async set(key, value){
    if(this.useRemote){
      try{
        const res = await window.storage.set(key, value, false);
        return !!res;
      } catch(e){
        console.error('PersistentStore.set failed against window.storage:', e);
        return false;
      }
    }
    try{ return safeStorage.setItem(key, value); } catch(e){ console.error('PersistentStore.set failed against localStorage fallback:', e); return false; }
  },
  async remove(key){
    if(this.useRemote){
      try{ await window.storage.delete(key, false); } catch(e){ /* fine if it never existed */ }
      return;
    }
    try{ safeStorage.removeItem(key); } catch(e){}
  }
};

