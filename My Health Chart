            <div style="background:#fff;padding:10px;border-radius:8px;border:1px solid #bae6fd;"><p style="font-size:9px;font-weight:700;color:#7dd3fc;text-transform:uppercase;margin:0 0 2px 0;">Emergency Contact</p><p style="font-size:12px;font-weight:700;margin:0;color:#0c4a6e;">${p.emergencyName||'Not set'}</p><p style="font-size:10px;margin:2px 0 0 0;color:#0369a1;">${p.emergencyPhone||'—'}</p></div>
            <div style="background:#fff;padding:10px;border-radius:8px;border:1px solid #bae6fd;"><p style="font-size:9px;font-weight:700;color:#7dd3fc;text-transform:uppercase;margin:0 0 2px 0;">Emergency Address</p><p style="font-size:11px;font-weight:700;margin:0;color:#0c4a6e;">${p.emergencyAddress||'Not set'}</p></div>
          </div>
