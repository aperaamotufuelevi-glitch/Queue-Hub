    quickUpdateStatus(rideId, newStatus){
      const ride = App.state.rides.find(r=>r.id===rideId); if(!ride) return;
      const oldStatus = ride.status; if(oldStatus===newStatus) return;
      ride.status = newStatus; ride.updatedAt = new Date().toISOString();
