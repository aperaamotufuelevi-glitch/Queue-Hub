        trendDetailHtml = `<div style="margin-top:10px;display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">
            <div style="background:#eff6ff;border:1px solid #bfdbfe;padding:10px;border-radius:8px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#2563eb;text-transform:uppercase;margin:0;">General Trend</p><p style="font-size:18px;font-weight:900;margin:2px 0 0 0;">${result.generalTrendIcon} ${result.generalTrendLabel}</p></div>
            <div style="background:#eff6ff;border:1px solid #bfdbfe;padding:10px;border-radius:8px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#2563eb;text-transform:uppercase;margin:0;">Recent Direction</p><p style="font-size:18px;font-weight:900;margin:2px 0 0 0;">${result.recentDirectionIcon} ${result.recentDirectionLabel}</p></div>
          </div>
          <div style="margin-top:8px;display:grid;grid-template-columns:repeat(2,1fr);gap:10px;">
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;"><p style="font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin:0;">Overall Status</p><p style="font-size:12px;font-weight:700;margin:2px 0 0 0;">${result.overallStatusLabel}</p></div>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;"><p style="font-size:9px;font-weight:700;color:#64748b;text-transform:uppercase;margin:0;">Confidence</p><p style="font-size:12px;font-weight:700;margin:2px 0 0 0;">${result.confidenceLabel}</p></div>
          </div>
          <div style="margin-top:10px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 12px;">
            <p style="font-size:9px;font-weight:700;color:#92400e;text-transform:uppercase;margin:0 0 4px 0;">Why?</p>
            <ul style="margin:0;padding-left:16px;font-size:10px;color:#78350f;line-height:1.6;">
              ${result.reasons.slice(0,6).map(r=>`<li>${r}</li>`).join('') || '<li>No notable changes to report.</li>'}
            </ul>
          </div>`;

        // Actual chart "waves" (line curves), not just averages - filled in by
        // renderPrintCharts() right before printing. The canvases start empty;
        // doPrint()'s callback builds real Chart.js instances on them once
        // they're in the DOM and visible, then its double-requestAnimationFrame
        // gives the charts a frame to paint before window.print() fires.
        chartsHtml = `<h3 style="font-size:12px;font-weight:700;margin:16px 0 8px 0;">Vital Trend Charts (Last ${Math.min(v.length,30)} Readings)</h3>
          <div style="border:1px solid #e2e8f0;border-radius:8px;padding:10px;margin-bottom:12px;"><canvas id="print-chart-bp" width="680" height="200"></canvas></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div style="border:1px solid #e2e8f0;border-radius:8px;padding:10px;"><canvas id="print-chart-pulse" width="320" height="170"></canvas></div>
            <div style="border:1px solid #e2e8f0;border-radius:8px;padding:10px;"><canvas id="print-chart-temp" width="320" height="170"></canvas></div>
          </div>`;
      }
      return `<h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:8px;">Health Analytics</h1>
