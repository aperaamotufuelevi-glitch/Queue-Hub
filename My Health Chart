.tr-tab.active{background:#fff;color:#1e3a5f;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.tr-log-entry{padding:8px 12px;border-bottom:1px solid #e2e8f0;font-size:12px;display:flex;gap:10px;align-items:flex-start}
.tr-log-time{color:#64748b;white-space:nowrap;font-size:11px;min-width:140px}
.tr-log-action{font-weight:600}
.tr-log-create{color:#16a34a}.tr-log-update{color:#f59e0b}.tr-log-delete{color:#dc2626}.tr-log-print{color:#3b82f6}.tr-log-view{color:#1e3a5f}.tr-log-profile{color:#8b5cf6}
.tr-modal-header{background:#1e3a5f;color:#fff;padding:14px 18px;font-weight:700;display:flex;justify-content:space-between;align-items:center}
.tr-empty-state{text-align:center;padding:40px;color:#64748b}
.tr-empty-state-icon{font-size:48px;margin-bottom:8px}
.tr-section-title{font-size:14px;font-weight:700;color:#1e3a5f;margin:16px 0 10px;display:flex;align-items:center;gap:6px;text-transform:uppercase;letter-spacing:.5px}
.tr-addr-suggestions{position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #cbd5e1;border-radius:0 0 6px 6px;box-shadow:0 4px 12px rgba(0,0,0,.12);z-index:500;max-height:200px;overflow-y:auto;margin-top:-2px}
