    timeToMinutes(t){ if(!t) return null; const [h,m]=t.split(':').map(Number); return h*60+m; },
    minutesToTime(min){ if(min===null||min===undefined||isNaN(min)) return ''; min = min % (24*60); if(min<0) min += 24*60; const h=Math.floor(min/60), m=min%60; return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0'); },
    addMinutesToTime(t,mins){ const total=this.timeToMinutes(t); if(total===null) return ''; return this.minutesToTime(total+mins); },
    subtractMinutesFromTime(t,mins){ const total=this.timeToMinutes(t); if(total===null) return ''; return this.minutesToTime(total-mins); },
    onStartTimeChange(){
      const start = document.getElementById('rf-apptStart').value;
      if(start){
        const checkIn = this.subtractMinutesFromTime(start,15);
        document.getElementById('rf-checkIn').value = checkIn;
        document.getElementById('rf-puTime').value = this.subtractMinutesFromTime(checkIn,45);
        // Pickup Window: ends a configurable number of minutes before check-in,
        // and spans a configurable length before that - both set on the
        // Settings tab (defaults: ends 56 min before check-in, 30 min long,
        // e.g. a 7:25 AM check-in gives a 5:59 AM - 6:29 AM window).
        const s = App.state.settings || {};
        const bufferMin = (s.rideWindowBufferMin!=null && s.rideWindowBufferMin!=='') ? Number(s.rideWindowBufferMin) : 56;
        const lengthMin = (s.rideWindowLengthMin!=null && s.rideWindowLengthMin!=='') ? Number(s.rideWindowLengthMin) : 30;
        const windowEnd = this.subtractMinutesFromTime(checkIn, bufferMin);
        const windowStart = this.subtractMinutesFromTime(windowEnd, lengthMin);
        document.getElementById('rf-puWindowStart').value = windowStart;
        document.getElementById('rf-puWindowEnd').value = windowEnd;
