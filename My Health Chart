          const div = document.createElement('div'); div.className='p-4 flex items-center justify-between hover:bg-slate-50/50 dark:hover:bg-slate-700/30 cursor-pointer';
          div.onclick = ()=>{ App.ui.nav('rides'); App.transport.viewDetail(r.id); };
