    log(action, rideId, rideName, details){
      const entry = { id:'log-'+Date.now()+'-'+Math.random().toString(36).substr(2,5), timestamp:new Date().toISOString(), action, rideId:rideId||null, rideName:rideName||null, details:details||'' };
      App.state.logs.unshift(entry);
      // FIX: this array previously had no size cap at all - every view,
      // print, create, update, and delete action added one more entry
      // forever, for the life of the app. Over months of real use this
      // could grow into a meaningful chunk of the storage quota, and since
      // it's saved as part of the SAME combined JSON blob as everything
      // else, a bloated log could push a later, unrelated save (like
      // picking a Prescribing Doctor) over the quota limit and cause IT to
      // silently fail, while older data - saved before the log grew this
      // large - stays intact. Capping at the 500 most recent entries keeps
      // useful recent history without unbounded growth.
      if(App.state.logs.length > 100) App.state.logs.length = 100;
      App.data.save(true); // silent: this is a background activity-log entry, not the primary action - printing/viewing/etc. already succeeded before this runs
      this.renderLogs(); this.renderStats();
