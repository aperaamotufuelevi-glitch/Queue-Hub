        tr.innerHTML = `<td class="px-6 py-4 font-bold text-xs">${App.formatDate(v.date)}</td><td class="px-6 py-4 text-center font-bold">${v.systolic}/${v.diastolic}</td><td class="px-6 py-4 text-center">${v.heartRate}/${v.spo2}%</td><td class="px-6 py-4 text-center">${v.temp}°F</td>`;
        vBody.appendChild(tr);
      });

      const todayStr = new Date().toISOString().split('T')[0];
      const upcoming = App.state.rides.filter(r=>r.apptDate>=todayStr && r.status!=='cancelled').sort((a,b)=>a.apptDate.localeCompare(b.apptDate)).slice(0,5);
      const ridesList = document.getElementById('dash-rides-list'); const ridesEmpty = document.getElementById('dash-rides-empty');
      ridesList.innerHTML='';
