.tr-field{margin-bottom:12px}
.tr-field label{display:block;font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:.6px;margin-bottom:4px;font-weight:600}
.tr-field input,.tr-field select,.tr-field textarea{width:100%;padding:8px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:14px;font-family:inherit}
.tr-field textarea{resize:vertical;min-height:60px}
.tr-auto-calc{background:#f0fdf4 !important;border-color:#86efac !important;color:#166534 !important;font-weight:600}
.tr-auto-calc-label{color:#16a34a !important}
.tr-table{width:100%;border-collapse:collapse;font-size:13px}
.tr-table th{background:#1e3a5f;color:#ffd700;padding:10px;text-align:left;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.4px}
.tr-table td{padding:10px;border-bottom:1px solid #e2e8f0;background:#f8fafc}
.dark .tr-table td{background:#0f172a;color:#e2e8f0;border-color:#334155}
.tr-table tr:hover td{background:#f1f5f9}
.dark .tr-table tr:hover td{background:#1e293b}
.tr-badge{display:inline-block;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;text-transform:uppercase}
.tr-badge-scheduled{background:#dcfce7;color:#166534}
.tr-badge-pending{background:#fef3c7;color:#92400e}
.tr-badge-completed{background:#dbeafe;color:#1e40af}
.tr-badge-cancelled{background:#fee2e2;color:#991b1b}
.tr-highlight-yellow{background:#fff7ed;border-left:4px solid #f59e0b;padding:10px 14px;margin:8px 0;border-radius:0 6px 6px 0;font-size:13px}
.tr-highlight-red{background:#fef2f2;border-left:4px solid #dc2626;padding:10px 14px;margin:8px 0;border-radius:0 6px 6px 0;color:#991b1b;font-size:13px}
.tr-highlight-green{background:#f0fdf4;border-left:4px solid #16a34a;padding:10px 14px;margin:8px 0;border-radius:0 6px 6px 0;color:#166534;font-size:13px}
.tr-highlight-blue{background:#eff6ff;border-left:4px solid #3b82f6;padding:10px 14px;margin:8px 0;border-radius:0 6px 6px 0;color:#1e40af;font-size:13px}
.tr-detail-grid-header{background:#1e3a5f;color:#ffd700;padding:10px 14px;font-weight:700;font-size:13px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;border-radius:6px 6px 0 0}
.tr-detail-grid-body{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;padding:12px 14px;background:#f1f5f9;border-radius:0 0 6px 6px;margin-bottom:16px;border:1px solid #e2e8f0;border-top:none;font-size:13px}
.dark .tr-detail-grid-body{background:#1e293b;color:#e2e8f0}
.tr-tabs{display:flex;gap:2px;background:#e2e8f0;padding:4px;border-radius:8px;margin-bottom:16px}
