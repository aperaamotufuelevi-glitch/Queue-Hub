    init(){ this.renderQuestions('audit', this.AUDIT_Q); this.renderQuestions('dast', this.DAST_Q); this.renderQuestions('phq', this.PHQ_Q); this.renderQuestions('gad', this.GAD_Q); },
    renderQuestions(prefix, list){
      const container = document.getElementById('sb-'+prefix+'-questions'); if(!container) return;
      container.innerHTML = list.map((item,i)=>{
        const n = i+1; const qid = prefix+'-'+n;
        const optsHtml = item.opts.map(([label,score])=>`<button class="sb-option-btn" data-score="${score}" onclick="App.screening.selectOption(this)">${label}<span class="sb-score-label">Score: ${score}</span></button>`).join('');
        return `<div class="sb-question-block" data-q="${qid}"><span class="sb-question-number">${n}</span><span class="sb-question-text"${item.danger?' style="color:#dc2626;font-weight:700;"':''}>${item.q}</span><div class="sb-options">${optsHtml}</div></div>`;
      }).join('');
