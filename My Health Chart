    onFileSelected(e){
      const file = e.target.files[0] || null;
      this.currentFile = file;
      const label = document.getElementById('ai-import-filename');
      const btn = document.getElementById('ai-import-extract-btn');
      if(file){ if(label) label.innerText = file.name; if(btn) btn.disabled = false; }
      else { if(label) label.innerText = 'Tap to choose a file (PDF, photo, or text)'; if(btn) btn.disabled = true; }
    },
    fileToBase64(file){
      return new Promise((resolve, reject)=>{
        const r = new FileReader();
        r.onload = () => resolve(String(r.result).split(',')[1] || '');
        r.onerror = () => reject(new Error('Could not read that file.'));
        r.readAsDataURL(file);
      });
    },
    fileToText(file){
      return new Promise((resolve, reject)=>{
        const r = new FileReader();
        r.onload = () => resolve(String(r.result));
        r.onerror = () => reject(new Error('Could not read that file.'));
        r.readAsText(file);
      });
    },

    async extract(){
      const key = this.getKey();
      if(!key){ App.ui.toast('Add your Anthropic API key in Settings first.', 'error'); App.ui.nav('settings'); return; }
      const file = this.currentFile;
      if(!file){ App.ui.toast('Choose a file first.', 'error'); return; }
      const statusEl = document.getElementById('ai-import-status');
      const btn = document.getElementById('ai-import-extract-btn');
      if(statusEl){ statusEl.classList.remove('hidden'); statusEl.innerText = 'Reading document…'; }
      if(btn) btn.disabled = true;
      try{
        const contentBlocks = [];
        const type = file.type || '';
        const lowerName = (file.name||'').toLowerCase();
        if(type === 'application/pdf' || lowerName.endsWith('.pdf')){
          const b64 = await this.fileToBase64(file);
          contentBlocks.push({ type:'document', source:{ type:'base64', media_type:'application/pdf', data:b64 } });
        } else if(type.startsWith('image/')){
          const b64 = await this.fileToBase64(file);
          contentBlocks.push({ type:'image', source:{ type:'base64', media_type:type, data:b64 } });
        } else if(type === 'text/plain' || lowerName.endsWith('.txt')){
          const text = await this.fileToText(file);
          contentBlocks.push({ type:'text', text: 'Document text:\n\n' + text });
        } else {
          App.ui.toast('Unsupported file type. Please upload a PDF, an image (JPG/PNG/etc.), or a plain text file.', 'error');
          if(statusEl) statusEl.classList.add('hidden');
          if(btn) btn.disabled = false;
          return;
        }
        contentBlocks.push({ type:'text', text: this.EXTRACTION_PROMPT + '\n\nToday\'s date (for calculating relative dates if the document has no date of its own): ' + App.print.localISO(new Date()) });

        if(statusEl) statusEl.innerText = 'Claude is reading every page and building your full record… (this can take up to a minute)';
        const res = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            'x-api-key': key,
            'anthropic-version': '2023-06-01',
            'anthropic-dangerous-direct-browser-access': 'true'
          },
          body: JSON.stringify({
            model: this.getModel(),
            max_tokens: 16000,
            messages: [ { role:'user', content: contentBlocks } ]
          })
        });
        if(!res.ok){
          let msg = 'API error ' + res.status;
          try{ const errJson = await res.json(); if(errJson && errJson.error && errJson.error.message) msg = errJson.error.message; } catch(e){}
          throw new Error(msg);
        }
        const data = await res.json();
        if(data.stop_reason === 'max_tokens') throw new Error('This document is too long to capture in one pass without cutting information off. Split it into smaller files (a few pages each) and upload them one at a time.');
        const textOut = (data.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('\n');
        let cleaned = textOut.replace(/```json|```/g,'').trim();
        const firstBrace = cleaned.indexOf('{'), lastBrace = cleaned.lastIndexOf('}');
        if(firstBrace>0 || (lastBrace>-1 && lastBrace<cleaned.length-1)) cleaned = cleaned.slice(firstBrace, lastBrace+1);
        let parsed;
        try{ parsed = JSON.parse(cleaned); }
        catch(e){ throw new Error("Claude's response wasn't valid JSON - try again, or try a clearer scan/photo."); }

        // 1) Save the full Notes & Records entry immediately - the summary,
        //    every extracted detail, and the next-steps tracker. This is the
        //    "nothing left out" copy; it's kept even if individual items
        //    below are discarded instead of added.
        const record = App.records.buildFromExtraction(parsed, file.name);
        App.state.records.unshift(record);
        this.lastRecordId = record.id;
        App.transport.log('create', null, record.title, 'Document record created via AI Import');
        App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: record may not have saved — check your connection and try again.','error'); } });

        // 2) Stage structured items for review, with every field auto-filled.
        const addItems = (cat, arr, normalize) => {
          (Array.isArray(arr)?arr:[]).forEach(item=>{
            if(item && typeof item==='object') this.pending[cat].push(Object.assign(normalize(item), { recordId: record.id }));
          });
        };
        const str = v => (v===undefined||v===null) ? '' : String(v).trim();
        addItems('doctors', parsed.doctors, it=>({
          title: this.VALID_DOCTOR_TITLES.includes(it.title) ? it.title : 'Dr.',
          name: str(it.name), specialty: str(it.specialty), clinic: str(it.clinic),
          address: str(it.address), phone: str(it.phone), email: str(it.email)
        }));
        addItems('medications', parsed.medications, it=>({
          name: str(it.name), dose: str(it.dose), frequency: str(it.frequency), route: str(it.route),
          purpose: str(it.purpose) ? (str(it.purpose) + (str(it.purposeSource).toLowerCase()==='inferred' && !/likely/i.test(str(it.purpose)) ? ' (likely — not stated in document)' : '')) : '',
          doctorName: str(it.doctorName) || record.provider,
          lastFilledDate: str(it.lastFilledDate) || str(it.startDate),
          startDate: str(it.startDate), quantity: str(it.quantity), refills: str(it.refills),
          instructions: str(it.instructions), status: str(it.status)
        }));
        addItems('conditions', parsed.conditions, it=>({
          name: str(it.name), icd10: str(it.icd10), icd9: str(it.icd9),
          date: str(it.date) || record.docDate, priority: str(it.priority)
        }));
        addItems('allergies', parsed.allergies, it=>({
          name: str(it.name),
          severity: this.VALID_SEVERITIES.includes(it.severity) ? it.severity : 'Moderate',
          reaction: str(it.reaction)
        }));
        addItems('vitals', parsed.vitals, it=>({
          date: str(it.date) || record.docDate, time: str(it.time) || record.docTime || '12:00',
          systolic: str(it.systolic), diastolic: str(it.diastolic), heartRate: str(it.heartRate),
          spo2: str(it.spo2), temp: str(it.temp),
          notes: [str(it.notes), str(it.weight)?('Weight: '+str(it.weight)):'', 'From: '+record.title].filter(Boolean).join(' • ')
        }));

        const total = Object.keys(this.pending).reduce((a,k)=>a+this.pending[k].length,0);
        if(statusEl) statusEl.classList.add('hidden');
        if(btn) btn.disabled = false;
        App.ui.toast(`Full record saved to Notes & Records${total?` — ${total} item(s) ready to add below`:''}.`);
        this.renderReview();
        App.dashboard.render();
        const reviewEl = document.getElementById('ai-import-review');
        if(reviewEl) reviewEl.scrollIntoView({behavior:'smooth'});
      } catch(err){
        console.error('AI Import failed:', err);
        if(statusEl) statusEl.classList.add('hidden');
        if(btn) btn.disabled = false;
        App.ui.toast('AI extraction failed: ' + err.message, 'error');
      }
    },

    updateField(cat, idx, field, value){
      if(this.pending[cat] && this.pending[cat][idx]) this.pending[cat][idx][field] = value;
    },
    discardItem(cat, idx){ this.pending[cat].splice(idx,1); this.renderReview(); },
    // Returns an error string if an item can't be added yet, otherwise ''.
    validate(cat, item){
      if(cat==='medications' && !String(item.purpose||'').trim()) return `"${item.name||'Medication'}" needs a Purpose before it can be added.`;
      if(cat==='vitals'){
        const need = ['date','systolic','diastolic','heartRate','spo2'].filter(f=>!String(item[f]||'').trim());
        if(need.length) return 'This reading needs Date, Systolic, Diastolic, Pulse and SpO2 to go into your Vitals log (it is already kept in the document record).';
      }
      return '';
    },
    saveItem(cat, idx){
      const item = this.pending[cat][idx];
      if(!item) return;
      const err = this.validate(cat, item);
      if(err){ App.ui.toast(err, 'error'); return; }
      this._commit(cat, item);
      this.pending[cat].splice(idx,1);
      this.renderReview();
    },
    saveAll(cat){
      const items = this.pending[cat].slice();
      const keep = [];
      let added = 0;
      items.forEach(item=>{ if(this.validate(cat, item)) keep.push(item); else { this._commit(cat, item); added++; } });
      this.pending[cat] = keep;
      this.renderReview();
      App.ui.toast(keep.length ? `Added ${added}. ${keep.length} still need a required field filled in (highlighted).` : 'Added to your records.', keep.length?'info':'success');
    },
    saveEverything(){
      // Doctors first so medications can link to a just-added prescriber.
      ['doctors','medications','conditions','allergies','vitals'].forEach(cat=>{
        const keep = [];
        this.pending[cat].slice().forEach(item=>{ if(this.validate(cat, item)) keep.push(item); else this._commit(cat, item); });
        this.pending[cat] = keep;
      });
      const left = Object.keys(this.pending).reduce((a,k)=>a+this.pending[k].length,0);
      this.renderReview();
      App.ui.toast(left ? `Everything complete was added. ${left} item(s) still need a required field (highlighted).` : 'Everything was added to your records.', left?'info':'success');
    },
    _commit(cat, item){
      if(cat==='doctors') this._commitDoctor(item);
      else if(cat==='medications') this._commitMedication(item);
      else if(cat==='conditions') this._commitCondition(item);
      else if(cat==='allergies') this._commitAllergy(item);
      else if(cat==='vitals') this._commitVital(item);
    },
    _commitDoctor(it){
      const now = new Date().toISOString();
      const existing = it.name ? App.state.doctors.find(d=>d.name && d.name.toLowerCase()===it.name.toLowerCase()) : null;
      if(existing){
        // Same provider already in the Directory - fill in any blanks instead of creating a duplicate.
        ['specialty','clinic','address','phone','email'].forEach(f=>{ if(!existing[f] && it[f]) existing[f] = it[f]; });
        existing.updatedAt = now;
      } else {
        App.state.doctors.push({ id:'doctor-'+Date.now()+'-'+Math.random().toString(36).substr(2,4), title: this.VALID_DOCTOR_TITLES.includes(it.title)?it.title:'Dr.', name: it.name||'', specialty: it.specialty||'', clinic: it.clinic||'', address: it.address||'', phone: it.phone||'', email: it.email||'', createdAt: now, updatedAt: now });
      }
      App.transport.log(existing?'update':'create', null, it.name, existing?'Updated via AI Import':'Added via AI Import');
      App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: doctor may not have saved — check your connection and try again.','error'); } });
      App.doctors.render();
    },
    _commitMedication(it){
      const docName = String(it.doctorName||'').replace(/^dr\.?\s+/i,'').trim().toLowerCase();
      const doctorMatch = docName ? App.state.doctors.find(d=>d.name && (d.name.toLowerCase()===docName || d.name.toLowerCase().includes(docName) || docName.includes(d.name.toLowerCase()))) : null;
      const rec = it.recordId ? App.state.records.find(r=>r.id===it.recordId) : null;
      const notes = [
        it.route?('Route: '+it.route):'', it.instructions?('Directions: '+it.instructions):'',
        it.quantity?('Qty: '+it.quantity):'', it.refills?('Refills: '+it.refills):'',
        it.startDate?('Started: '+it.startDate):'', it.status&&it.status!=='unknown'?('Status: '+it.status):'',
        rec?('Source: '+rec.title+(rec.docDate?' ('+rec.docDate+')':'')):''
      ].filter(Boolean).join(' • ');
      const entry = { id: Date.now()+Math.floor(Math.random()*1000), name: it.name||'', dose: it.dose||'', frequency: it.frequency||'', purpose: it.purpose||'', medType:'standard', refillCycleDays:90, refillDate: /^\d{4}-\d{2}-\d{2}$/.test(it.lastFilledDate||'') ? it.lastFilledDate : '', nextRefillDate:'', refillStatus:'none', insuranceStatus:'', notes, doctorId: doctorMatch?doctorMatch.id:'', doctorName: doctorMatch?doctorMatch.name:(String(it.doctorName||'').replace(/^dr\.?\s+/i,'')) };
      if(entry.refillDate){ const d = new Date(entry.refillDate+'T00:00:00'); d.setDate(d.getDate()+90); entry.nextRefillDate = App.print.localISO(d); }
      App.state.medications.push(entry);
      App.transport.log('create', null, entry.name, 'Added via AI Import');
      App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: medication may not have saved — check your connection and try again.','error'); } });
      App.data.saveDoctorLinks();
      App.meds.render(); App.dashboard.render();
    },
    _commitCondition(it){
      const rec = it.recordId ? App.state.records.find(r=>r.id===it.recordId) : null;
      const docName = rec && rec.provider ? rec.provider.replace(/^dr\.?\s+/i,'').toLowerCase() : '';
      const doc = docName ? App.state.doctors.find(d=>d.name && d.name.toLowerCase().includes(docName)) : null;
      const entry = { id: Date.now()+Math.floor(Math.random()*1000), name: it.name||'', icd10: it.icd10||'', icd9: it.icd9||'', date: /^\d{4}-\d{2}-\d{2}$/.test(it.date||'') ? it.date : 'Unknown', resolvedDate:'Present', priority: it.priority||'', lastModifiedDate: rec?rec.docDate:'', lastModifiedByDoctorId: doc?doc.id:'', lastModifiedBy: doc?doc.name:'' };
      App.state.conditions.push(entry);
      App.transport.log('create', null, entry.name, 'Added via AI Import');
      App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: condition may not have saved — check your connection and try again.','error'); } });
      App.conditions.render();
    },
    _commitAllergy(it){
      const entry = { id: Date.now()+Math.floor(Math.random()*1000), name: it.name + (it.reaction?(' — '+it.reaction):''), severity: this.VALID_SEVERITIES.includes(it.severity)?it.severity:'Moderate' };
      App.state.allergies.push(entry);
      App.transport.log('create', null, entry.name, 'Added via AI Import');
      App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: allergy may not have saved — check your connection and try again.','error'); } });
      App.allergies.render();
    },
    _commitVital(it){
      const sys = parseInt(it.systolic), dia = parseInt(it.diastolic);
      const entry = { date: it.date, time: /^\d{1,2}:\d{2}$/.test(it.time||'') ? it.time.padStart(5,'0') : '12:00', systolic: String(sys), diastolic: String(dia), heartRate: String(parseInt(it.heartRate)), spo2: String(parseInt(it.spo2)), temp: it.temp||'', location:'Oral', notes: it.notes||'' };
      entry.pulsePressure = sys - dia;
      entry.map = Math.round(dia + (1/3*entry.pulsePressure));
      entry.id = Date.now()+Math.floor(Math.random()*1000);
      App.state.vitals.unshift(entry);
      App.state.vitals.sort((a,b)=> new Date(b.date+' '+b.time) - new Date(a.date+' '+a.time));
      App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: reading may not have saved — check your connection and try again.','error'); } });
      App.vitals.render(); App.dashboard.render();
    },

