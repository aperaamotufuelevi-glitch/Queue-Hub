  /* ============================================================
     GENERAL TREND ENGINE (deterministic, rule-based)
     ------------------------------------------------------------
     Single source of truth for the "General Trend" shown on both
     the live Analytics tab (App.analytics.render) and the printed
     Health Report (App.print.healthAnalyticsHTML) - both call
     App.trendEngine.computeGeneralTrend(vitals) instead of each
     running its own copy of this logic.

     Deliberately has NO DOM / App.state dependency - it only reads
     the plain vitals array it is given and returns plain data. That
     keeps it deterministic and independently testable (see
     /test/trend-engine.test.js, which extracts this exact block out
     of this HTML file and runs it under Node against the dataset in
     the spec plus a set of edge cases).

     Design summary:
     - Each vital sign is analyzed on its own (systolic, diastolic,
       heart rate, SpO2, temperature) and NEVER averaged together
       with another vital sign - different units, scales, and
       clinical meaning.
     - "Badness" = how far a reading sits outside its configured
       reference range (0 if inside the range). This lets one piece
       of logic handle "higher is better" (SpO2), "lower is better"
       (blood pressure), and "neither" (heart rate, temperature)
       metrics uniformly, without hard-coding a direction per metric.
     - Trend (IMPROVING / WORSENING / STABLE) compares the AVERAGE
       badness of the earlier half of the period to the recent half -
       not just the single latest reading vs. some earlier point,
       which was the bug this replaces.
     - Status (NORMAL...SEVERELY_ABNORMAL) is a separate concept from
       Trend, driven by how abnormal the readings are and how
       persistent that abnormality is across the whole period - so a
       metric can be "Trend: Improving, Status: Below Reference
       Range" at the same time.
     - The overall General Trend is produced by explicit named rules
       over the per-metric Trend/Status results (combineOverallTrend)
       - never by averaging raw numbers across different vital signs.
     ============================================================ */
  trendEngine: {
    config: {
      // The single place clinical reference ranges live. Edit these to
      // match your own doctor's guidance - they are general reference
      // ranges, not a diagnosis.
      healthReferenceRanges: {
        bloodPressure: {
          systolic:  { lower: null, upper: 120 },
          diastolic: { lower: null, upper: 80  }
        },
        heartRate:   { lower: 60,   upper: 100 },
        spo2:        { lower: 95,   upper: 100 },
        temperature: { lower: 97.6, upper: 99.6 }
      },
      // Per-metric metadata. `field` is the key on a vitals record;
      // `severity.mild/moderate/severe` is how far outside the reference
      // range (in the metric's own units) counts as each severity level;
      // `meaningfulChange` is the minimum change in average badness
      // between the earlier and recent half of the period before it
      // counts as a real trend rather than noise; `plausibleBounds` is
      // the widest range a home reading could plausibly be correct at
      // all - outside it, a reading is flagged as a likely device/entry
      // error rather than trusted at face value. All configurable.
      metrics: {
        systolic:    { field:'systolic',  label:'Systolic BP',  group:'Blood Pressure', importance:1.0, severity:{mild:8,  moderate:20, severe:40}, meaningfulChange:3,   plausibleBounds:{min:60,max:260} },
        diastolic:   { field:'diastolic', label:'Diastolic BP', group:'Blood Pressure', importance:1.0, severity:{mild:5,  moderate:15, severe:30}, meaningfulChange:2,   plausibleBounds:{min:30,max:200} },
        heartRate:   { field:'heartRate', label:'Heart Rate',   group:'Heart Rate',     importance:0.8, severity:{mild:10, moderate:25, severe:40}, meaningfulChange:5,   plausibleBounds:{min:25,max:230} },
        spo2:        { field:'spo2',      label:'SpO2',         group:'SpO2',           importance:1.0, severity:{mild:2,  moderate:5,  severe:8 }, meaningfulChange:1.5, plausibleBounds:{min:50,max:100} },
        temperature: { field:'temp',      label:'Temperature',  group:'Temperature',    importance:0.7, severity:{mild:0.5,moderate:1.5,severe:3 }, meaningfulChange:0.3, plausibleBounds:{min:95, max:107} }
      },
      // >= this fraction of a metric's readings being abnormal bumps its
      // severity classification up one level (persistence matters), but
      // only once there's enough data (n>=3) that "most readings" is a
      // meaningful statement.
      persistenceEscalationThreshold: 0.7,
      // A metric counts as "dominating" the overall picture when it is at
      // least moderately abnormal AND abnormal in at least this fraction
      // of the period's readings.
      dominantAbnormalityThreshold: 0.5,
      // Modified z-score (via median absolute deviation - robust to the
      // very outliers it's looking for) threshold for flagging an
      // isolated statistical outlier. Only applied with n>=5.
      outlierModifiedZThreshold: 3.5
    },

    getReferenceRange(key){
      const r = this.config.healthReferenceRanges;
      if(key==='systolic') return r.bloodPressure.systolic;
      if(key==='diastolic') return r.bloodPressure.diastolic;
      return r[key];
    },

    // ---- small stats helpers (pure - no App.state reads) ----
    mean(arr){ return arr.length ? arr.reduce((a,b)=>a+b,0)/arr.length : null; },
    median(arr){
      if(!arr.length) return null;
      const s = arr.slice().sort((a,b)=>a-b);
      const mid = Math.floor(s.length/2);
      return s.length%2 ? s[mid] : (s[mid-1]+s[mid])/2;
    },
    stdev(arr){
      if(arr.length<2) return 0;
      const m = this.mean(arr);
      const variance = arr.reduce((a,v)=>a+(v-m)*(v-m),0)/(arr.length-1);
      return Math.sqrt(variance);
    },
    // Distance outside the reference range; 0 if inside it. Handles
    // "higher is better", "lower is better", and "neither" metrics with
    // the same formula.
    badness(value, range){
      if(value==null || isNaN(value)) return null;
      if(range.lower!=null && value<range.lower) return range.lower-value;
      if(range.upper!=null && value>range.upper) return value-range.upper;
      return 0;
    },
    // Sorts vitals chronologically ascending (oldest -> newest).
    // Defensive: App.state stores vitals newest-first, but this engine
    // never assumes caller ordering.
    chronological(vitals){
      return vitals.slice().sort((a,b)=> new Date((a.date||'1970-01-01')+'T'+(a.time||'00:00')) - new Date((b.date||'1970-01-01')+'T'+(b.time||'00:00')));
    },

    // Turns raw vitals records into {value, date, time, id, valid} points
    // for one metric.
    extractSeries(vitals, metricKey){
      const field = this.config.metrics[metricKey].field;
      return vitals.map(v=>{
        const raw = v[field];
        const value = (raw===undefined||raw===null||raw==='') ? null : parseFloat(raw);
        const valid = value!==null && !isNaN(value) && !!v.date;
        return { value, date:v.date, time:v.time, id:v.id, valid };
      });
    },

    // Flags data-quality issues for one metric's points. Returns
    // { [id]: ['IMPLAUSIBLE_VALUE', ...] }. Never silently drops a
    // reading - callers decide whether/how to exclude flagged points.
    flagDataQuality(points, metricKey){
      const bounds = this.config.metrics[metricKey].plausibleBounds;
      const flags = {};
      const add = (id, reason) => { (flags[id] = flags[id]||[]).push(reason); };

      points.forEach(p=>{
        if(p.value!=null && !isNaN(p.value) && !p.date) add(p.id,'MISSING_TIMESTAMP');
        if(!p.valid) return;
        if(bounds && (p.value<bounds.min || p.value>bounds.max)) add(p.id,'IMPLAUSIBLE_VALUE');
      });

      // Duplicates: same date+time+value for this metric - keep the
      // first occurrence usable, flag the repeat(s).
      const seen = new Set();
      points.forEach(p=>{
        if(!p.valid) return;
        const key = `${p.date}|${p.time}|${p.value}`;
        if(seen.has(key)) add(p.id,'DUPLICATE'); else seen.add(key);
      });

      // Isolated statistical outliers via median absolute deviation.
      // Only meaningful with enough points, and only run against values
      // that aren't already flagged as implausible.
      const clean = points.filter(p=>p.valid && !(flags[p.id]||[]).includes('IMPLAUSIBLE_VALUE'));
      if(clean.length>=5){
        const vals = clean.map(p=>p.value);
        const med = this.median(vals);
        const mad = this.median(vals.map(v=>Math.abs(v-med)));
        if(mad>0){
          clean.forEach(p=>{
            const modZ = 0.6745*(p.value-med)/mad;
            if(Math.abs(modZ) > this.config.outlierModifiedZThreshold) add(p.id,'ISOLATED_OUTLIER');
          });
        }
      }
      return flags;
    },

    // Full independent analysis of one metric. `vitals` must already be
    // chronological ascending.
    analyzeMetric(metricKey, vitals){
      const meta = this.config.metrics[metricKey];
      const range = this.getReferenceRange(metricKey);
      const rawPoints = this.extractSeries(vitals, metricKey);
      const dqFlags = this.flagDataQuality(rawPoints, metricKey);
      const excluded = f => (f||[]).some(r=>r==='IMPLAUSIBLE_VALUE'||r==='DUPLICATE'||r==='MISSING_TIMESTAMP');
      const usablePoints = rawPoints.filter(p=>p.valid && !excluded(dqFlags[p.id]));
      const totalReadings = rawPoints.filter(p=>p.value!=null && !isNaN(p.value)).length;
      const flaggedCount = rawPoints.filter(p=>p.value!=null && !isNaN(p.value) && (dqFlags[p.id]||[]).length).length;
      const n = usablePoints.length;

      const base = { key:metricKey, label:meta.label, group:meta.group, importance:meta.importance,
        n, totalReadings, flaggedCount, dataQualityFlags:dqFlags };

      if(n===0){
        return Object.assign(base, {
          status:'INSUFFICIENT_DATA', trend:'INSUFFICIENT_DATA', recentDirection:'INSUFFICIENT_DATA',
          confidence:0,
          reasons:[ flaggedCount>0
            ? `No reliable ${meta.label} readings - ${flaggedCount} reading${flaggedCount>1?'s were':' was'} flagged for data-quality review.`
            : `No ${meta.label} readings in this period.` ]
        });
      }

      const withBadness = usablePoints.map(p=>({...p, badness:this.badness(p.value, range)}));
      const values = withBadness.map(p=>p.value);
      const mean = this.mean(values), median = this.median(values);
      const min = Math.min(...values), max = Math.max(...values), sd = this.stdev(values);
      const first = withBadness[0].value, last = withBadness[withBadness.length-1].value;

      const abnormal = withBadness.filter(p=>p.badness>0);
      const percentAbnormal = abnormal.length / n;

      let status = 'NORMAL';
      if(abnormal.length>0){
        const meanAbnormalBadness = this.mean(abnormal.map(p=>p.badness));
        status = meanAbnormalBadness>=meta.severity.severe ? 'SEVERELY_ABNORMAL'
               : meanAbnormalBadness>=meta.severity.moderate ? 'MODERATELY_ABNORMAL'
               : 'MILDLY_ABNORMAL';
        if(n>=3 && percentAbnormal>=this.config.persistenceEscalationThreshold && status!=='SEVERELY_ABNORMAL'){
          status = status==='MILDLY_ABNORMAL' ? 'MODERATELY_ABNORMAL' : 'SEVERELY_ABNORMAL';
        }
      }

      let trend = 'INSUFFICIENT_DATA', earlierAvg=null, recentAvg=null, earlierBadAvg=null, recentBadAvg=null;
      if(n>=2){
        const earlierCount = Math.floor(n/2);
        const earlierPts = withBadness.slice(0, earlierCount);
        const recentPts = withBadness.slice(earlierCount);
        earlierAvg = this.mean(earlierPts.map(p=>p.value));
        recentAvg = this.mean(recentPts.map(p=>p.value));
        earlierBadAvg = this.mean(earlierPts.map(p=>p.badness));
        recentBadAvg = this.mean(recentPts.map(p=>p.badness));
        const delta = earlierBadAvg - recentBadAvg; // >0 = less bad recently = improving
        if(delta > meta.meaningfulChange) trend = 'IMPROVING';
        else if(delta < -meta.meaningfulChange) trend = 'WORSENING';
        else trend = 'STABLE';
      }

      let recentDirection = 'INSUFFICIENT_DATA';
      if(n>=2){
        const prevBad = withBadness[n-2].badness, lastBad = withBadness[n-1].badness;
        const stepThreshold = meta.meaningfulChange/2;
        if(prevBad - lastBad > stepThreshold) recentDirection = 'IMPROVING';
        else if(lastBad - prevBad > stepThreshold) recentDirection = 'WORSENING';
        else recentDirection = 'STABLE';
      }

      let confidence = 1.0;
      if(n<3) confidence -= 0.35; else if(n<5) confidence -= 0.15;
      if(totalReadings>0) confidence -= 0.4*(flaggedCount/totalReadings);
      confidence = Math.max(0, Math.min(1, confidence));

      const reasons = [];
      const pct = Math.round(percentAbnormal*100);
      if(status!=='NORMAL'){
        const sevWord = status==='SEVERELY_ABNORMAL'?'severely':status==='MODERATELY_ABNORMAL'?'moderately':'mildly';
        reasons.push(`${meta.label} is ${sevWord} outside the reference range in ${pct}% of readings`);
      } else {
        reasons.push(`${meta.label} stayed within the reference range`);
      }
      if(trend==='IMPROVING') reasons.push(`${meta.label} trend improved over the period (recent readings closer to range than earlier ones)`);
      if(trend==='WORSENING') reasons.push(`${meta.label} trend worsened over the period (recent readings farther from range than earlier ones)`);
      if(recentDirection==='IMPROVING' && trend!=='IMPROVING') reasons.push(`Most recent ${meta.label} reading improved on the one before it`);
      if(recentDirection==='WORSENING' && trend!=='WORSENING') reasons.push(`Most recent ${meta.label} reading worsened compared to the one before it`);
      if(flaggedCount>0) reasons.push(`${flaggedCount} ${meta.label} reading${flaggedCount>1?'s':''} flagged for data-quality review and excluded from this analysis`);

      return Object.assign(base, { status, trend, recentDirection, mean, median, min, max, stdev:sd,
        first, last, earlierAvg, recentAvg, earlierBadAvg, recentBadAvg, percentAbnormal, confidence, reasons });
    },

    confidenceLabel(c){ return c>=0.75 ? 'High' : c>=0.5 ? 'Moderate' : 'Low'; },

    // Combines the independent per-metric results into ONE overall
    // General Trend using explicit named rules - never by averaging raw
    // measurements across different vital signs.
    combineOverallTrend(metricResults){
      const usable = metricResults.filter(m=>m.trend!=='INSUFFICIENT_DATA');
      if(usable.length===0){
        return { trend:'INCONCLUSIVE', confidence:0.2,
          reasons:['Not enough reliable readings across the tracked vital signs to determine a trend.'] };
      }

      const worsening = usable.filter(m=>m.trend==='WORSENING');
      const improving = usable.filter(m=>m.trend==='IMPROVING');
      const importantWorsening = worsening.filter(m=>m.importance>=0.8);
      const substantialWorsening = worsening.some(m=>m.importance>=0.8 && (m.status==='MODERATELY_ABNORMAL'||m.status==='SEVERELY_ABNORMAL'));
      const dominantAbnormal = metricResults.filter(m=>(m.status==='MODERATELY_ABNORMAL'||m.status==='SEVERELY_ABNORMAL') && m.percentAbnormal>=this.config.dominantAbnormalityThreshold);

      // Overall badness delta, normalized per metric by its own
      // "moderate" severity threshold so different units/scales are never
      // blended as raw numbers - just unit-free "how many
      // moderate-severity-units better/worse" fractions, weighted by
      // clinical importance. Used only as one more explicit check, not a
      // substitute for the rules above.
      let deltaSum = 0, weightSum = 0;
      usable.forEach(m=>{
        const modTh = this.config.metrics[m.key].severity.moderate;
        if(modTh>0 && m.earlierBadAvg!=null && m.recentBadAvg!=null){
          deltaSum += m.importance*(m.earlierBadAvg-m.recentBadAvg)/modTh;
          weightSum += m.importance;
        }
      });
      const normalizedDelta = weightSum ? deltaSum/weightSum : 0; // >0 better, <0 worse

      let trend;
      if(importantWorsening.length>=2 || substantialWorsening || normalizedDelta<=-0.5){
        trend = 'WORSENING';
      } else if(worsening.length===0 && improving.length>0 && improving.length>=Math.ceil(usable.length/2) && dominantAbnormal.length===0 && normalizedDelta>0.15){
        trend = 'IMPROVING';
      } else if(improving.length>0 && (worsening.length>0 || dominantAbnormal.length>0)){
        trend = 'MIXED';
      } else if(worsening.length>0){
        trend = 'MIXED';
      } else {
        trend = 'STABLE';
      }

      const weightedConfidence = usable.reduce((a,m)=>a+m.importance*m.confidence,0) / usable.reduce((a,m)=>a+m.importance,0);
      let confidence = weightedConfidence;
      if(trend==='MIXED') confidence *= 0.95;
      if(usable.length<metricResults.length) confidence *= 0.9;
      confidence = Math.max(0, Math.min(1, confidence));

      // Build the "Why?" explanation, most clinically important first.
      const priority = { SEVERELY_ABNORMAL:0, MODERATELY_ABNORMAL:1, MILDLY_ABNORMAL:2, NORMAL:3, INSUFFICIENT_DATA:4 };
      const ordered = metricResults.slice().sort((a,b)=> (priority[a.status]-priority[b.status]) || (b.importance-a.importance));
      const reasons = [];
      ordered.forEach(m=> m.reasons.forEach(r=> reasons.push(r)));

      return { trend, confidence, reasons };
    },

    recentDirectionSummary(metricResults){
      const usable = metricResults.filter(m=>m.recentDirection!=='INSUFFICIENT_DATA');
      if(usable.length===0) return 'INSUFFICIENT_DATA';
      const improving = usable.filter(m=>m.recentDirection==='IMPROVING').length;
      const worsening = usable.filter(m=>m.recentDirection==='WORSENING').length;
      if(improving>0 && worsening>0) return 'MIXED';
      if(improving>worsening && improving>0) return 'IMPROVING';
      if(worsening>improving && worsening>0) return 'WORSENING';
      return 'STABLE';
    },

    overallStatusSummary(metricResults){
      const usable = metricResults.filter(m=>m.status!=='INSUFFICIENT_DATA');
      if(usable.length===0) return 'INSUFFICIENT_DATA';
      if(usable.some(m=>m.status==='SEVERELY_ABNORMAL')) return 'SEVERELY_ABNORMAL';
      const moderate = usable.filter(m=>m.status==='MODERATELY_ABNORMAL').length;
      if(moderate>=2) return 'MODERATELY_ABNORMAL_MULTIPLE';
      if(moderate>0) return 'MODERATELY_ABNORMAL';
      if(usable.some(m=>m.status==='MILDLY_ABNORMAL')) return 'MILDLY_ABNORMAL';
      return 'NORMAL';
    },

    // Recent Direction shares this same icon set (it uses the same
    // IMPROVING/WORSENING/STABLE/MIXED vocabulary as General Trend, plus
    // INSUFFICIENT_DATA when there isn't a prior reading to compare to).
    ICONS: { IMPROVING:'\u{1F4C8}', WORSENING:'\u{1F4C9}', STABLE:'\u{27A1}\u{FE0F}', MIXED:'\u{2195}\u{FE0F}', INCONCLUSIVE:'\u{26AA}', INSUFFICIENT_DATA:'\u{26AA}' },
    LABELS: { IMPROVING:'Improving', WORSENING:'Worsening', STABLE:'Stable', MIXED:'Mixed', INCONCLUSIVE:'Inconclusive',
      NORMAL:'Normal', MILDLY_ABNORMAL:'Mildly Abnormal', MODERATELY_ABNORMAL:'Moderately Abnormal',
      MODERATELY_ABNORMAL_MULTIPLE:'Moderately Abnormal (Multiple Metrics)', SEVERELY_ABNORMAL:'Severely Abnormal',
      INSUFFICIENT_DATA:'Insufficient Data' },

    // Main entry point. `vitals` can be in any order and any subset (e.g.
    // already filtered to a time range) - returns a full, explainable
    // result object. Never throws on empty input.
    computeGeneralTrend(vitals){
      // Only drop null/undefined entries here - a record with a value but
      // no date is a real data-quality problem (MISSING_TIMESTAMP) and
      // must still reach analyzeMetric() to be flagged, not be silently
      // dropped before it gets the chance.
      const chron = this.chronological((vitals||[]).filter(v=>v));
      const metricKeys = Object.keys(this.config.metrics);
      const metrics = {};
      metricKeys.forEach(k=> metrics[k] = this.analyzeMetric(k, chron));
      const metricList = metricKeys.map(k=>metrics[k]);

      const overall = this.combineOverallTrend(metricList);
      const recentDirection = this.recentDirectionSummary(metricList);
      const overallStatus = this.overallStatusSummary(metricList);

      const dataQualityWarnings = [];
      metricList.forEach(m=>{
        Object.keys(m.dataQualityFlags||{}).forEach(id=>{
          m.dataQualityFlags[id].forEach(reason=> dataQualityWarnings.push({ metric:m.label, id, reason }));
        });
      });

      return {
        generalTrend: overall.trend,
        generalTrendLabel: this.LABELS[overall.trend],
        generalTrendIcon: this.ICONS[overall.trend],
        confidence: overall.confidence,
        confidenceLabel: this.confidenceLabel(overall.confidence),
        reasons: overall.reasons,
        recentDirection,
        recentDirectionLabel: this.LABELS[recentDirection],
        recentDirectionIcon: this.ICONS[recentDirection],
        overallStatus,
        overallStatusLabel: this.LABELS[overallStatus],
        metrics,
        dataQualityWarnings,
        readingsAnalyzed: chron.length
      };
    }
  },
  /* === TREND ENGINE END === */

  analytics: {
    timeRange: 30, charts: {},
    setTimeRange(days){ this.timeRange = days; document.querySelectorAll('.range-btn').forEach(b=>{ b.classList.remove('active-range'); if(parseInt(b.dataset.range)===days) b.classList.add('active-range'); }); this.render(); },
    render(){
      const now = new Date();
      const filtered = App.state.vitals.filter(v=>{ const d = new Date(v.date+'T00:00:00'); return (now-d)/86400000 <= this.timeRange; }).reverse();
      this.renderAssessments();
      App.charts.renderVitalCards('avc', filtered);
      const note = document.getElementById('analytics-vc-note');
      if(note) note.innerText = filtered.length > App.charts.maxLabeledPoints ? `Showing ${filtered.length} readings — point labels are hidden past ${App.charts.maxLabeledPoints} to avoid clutter. Hover (or tap) any point on the line for its exact value.` : '';
      if(filtered.length===0) return;
      const avgSys = Math.round(filtered.reduce((a,v)=>a+parseInt(v.systolic),0)/filtered.length);
      const avgDia = Math.round(filtered.reduce((a,v)=>a+parseInt(v.diastolic),0)/filtered.length);
      const avgHR = Math.round(filtered.reduce((a,v)=>a+parseInt(v.heartRate),0)/filtered.length);
      const avgSpO2 = Math.round(filtered.reduce((a,v)=>a+parseInt(v.spo2),0)/filtered.length);
      const tempsAll = filtered.map(v=>parseFloat(v.temp)).filter(t=>!isNaN(t));
      document.getElementById('stats-avg-bp').innerText = `${avgSys}/${avgDia}`;
      document.getElementById('stats-avg-hr').innerText = `${avgHR} bpm`;
      document.getElementById('stats-avg-spo2').innerText = `${avgSpO2}%`;
      const avgTempEl = document.getElementById('stats-avg-temp');
      if(avgTempEl) avgTempEl.innerText = tempsAll.length ? `${(tempsAll.reduce((a,b)=>a+b,0)/tempsAll.length).toFixed(1)}°F` : '--°F';

      // Deterministic, metric-aware, reference-range-aware trend
      // calculation - see App.trendEngine above. Replaces the old
      // "systolic average of the second half vs. the first half" logic,
      // which ignored SpO2, diastolic BP, heart rate, and temperature
      // entirely and could report "Improving" purely because systolic
      // ticked down, even with persistently abnormal SpO2/diastolic.
      const result = App.trendEngine.computeGeneralTrend(filtered);
      document.getElementById('stats-trend-icon').innerHTML = result.generalTrendIcon;
      document.getElementById('stats-trend-text').innerText = result.generalTrendLabel;
      const rdIcon = document.getElementById('stats-recent-direction-icon'); if(rdIcon) rdIcon.innerHTML = result.recentDirectionIcon;
      const rd = document.getElementById('stats-recent-direction'); if(rd) rd.innerText = result.recentDirectionLabel;
      const os = document.getElementById('stats-overall-status'); if(os) os.innerText = result.overallStatusLabel;
      const cf = document.getElementById('stats-confidence'); if(cf) cf.innerText = result.confidenceLabel;
      const reasonsList = document.getElementById('stats-trend-reasons');
      if(reasonsList) reasonsList.innerHTML = result.reasons.slice(0,6).map(r=>`<li>${r}</li>`).join('') || '<li>No notable changes to report.</li>';
    },
    renderAssessments(){
      const body = document.getElementById('assessments-body'); const empty = document.getElementById('assessments-empty');
      if(!body) return;
      body.innerHTML='';
      if(App.state.screenings.length===0){ empty.classList.remove('hidden'); return; }
      empty.classList.add('hidden');
      const L = App.screening.scoreLabel;
      App.state.screenings.slice().reverse().forEach(s=>{
        const tr = document.createElement('tr'); tr.className='border-b border-slate-50 dark:border-slate-800/50';
        const flags = [];
        if(s.suicideRisk) flags.push('<span class="px-2 py-0.5 bg-rose-100 text-rose-700 rounded text-[10px] font-bold uppercase">Suicide Risk</span>');
        if(s.clinicalSignificant) flags.push('<span class="px-2 py-0.5 bg-amber-100 text-amber-700 rounded text-[10px] font-bold uppercase">Clinically Significant</span>');
        tr.innerHTML = `<td class="px-6 py-4 font-bold text-xs">${App.formatDate(s.date)}</td>
          <td class="px-6 py-4 text-center"><div class="font-bold">${s.auditScore}</div><div class="text-[10px] text-slate-400">${L('audit',s.auditScore)}</div></td>
          <td class="px-6 py-4 text-center"><div class="font-bold">${s.dastScore}</div><div class="text-[10px] text-slate-400">${L('dast',s.dastScore)}</div></td>
          <td class="px-6 py-4 text-center"><div class="font-bold">${s.phqScore}</div><div class="text-[10px] text-slate-400">${L('phq',s.phqScore)}</div></td>
          <td class="px-6 py-4 text-center"><div class="font-bold">${s.gadScore}</div><div class="text-[10px] text-slate-400">${L('gad',s.gadScore)}</div></td>
          <td class="px-6 py-4">${flags.join(' ')||'<span class="text-slate-300">None</span>'}</td>
          <td class="px-6 py-4 text-right"><button onclick="App.screening.deleteRecord('${s.id}')" class="text-slate-300 hover:text-rose-500"><i class="fa-solid fa-trash-can"></i></button></td>`;
        body.appendChild(tr);
      });
    }
  },

  search: {
    init(){
      const input = document.getElementById('global-search'); const results = document.getElementById('search-results-dropdown');
      const container = document.getElementById('search-results-container'); const clearBtn = document.getElementById('clear-search');
      input.oninput = (e)=>{
        const query = e.target.value.toLowerCase();
        if(query.length<2){ results.classList.add('hidden'); clearBtn.classList.add('hidden'); return; }
        clearBtn.classList.remove('hidden');
        const matches = this.performSearch(query);
        this.renderResults(matches, container);
        results.classList.remove('hidden');
      };
      clearBtn.onclick = ()=>{ input.value=''; results.classList.add('hidden'); clearBtn.classList.add('hidden'); };
      document.addEventListener('click',(e)=>{ if(!results.contains(e.target) && e.target!==input) results.classList.add('hidden'); });
    },
    performSearch(q){
      const res = [];
      App.state.vitals.forEach(v=>{ if(String(v.systolic).includes(q)||String(v.diastolic).includes(q)||(v.notes||'').toLowerCase().includes(q)||(v.date||'').includes(q)) res.push({type:'Vital', label:`${v.systolic}/${v.diastolic} mmHg`, sub:`${App.formatDate(v.date)} - ${v.notes||''}`, tab:'vitals'}); });
      App.state.medications.forEach(m=>{ if((m.name||'').toLowerCase().includes(q)||(m.purpose||'').toLowerCase().includes(q)) res.push({type:'Medication', label:m.name, sub:`${m.dose} for ${m.purpose||''}`, tab:'meds'}); });
      App.state.doctors.forEach(d=>{ if((d.name||'').toLowerCase().includes(q)||(d.specialty||'').toLowerCase().includes(q)||(d.clinic||'').toLowerCase().includes(q)) res.push({type:'Doctor', label:`${d.title||'Dr.'} ${d.name}`, sub:d.specialty||d.clinic||'', tab:'doctors'}); });
      App.state.conditions.forEach(c=>{ if((c.name||'').toLowerCase().includes(q)) res.push({type:'Condition', label:c.name, sub:c.status, tab:'conditions'}); });
      App.state.rides.forEach(r=>{ if((r.name||'').toLowerCase().includes(q)||(r.provider||'').toLowerCase().includes(q)||(r.apptDate||'').includes(q)) res.push({type:'Ride', label:`${r.name} — ${App.formatDateShort(r.apptDate)}`, sub:r.provider||'', tab:'rides'}); });
      (App.state.records||[]).forEach(r=>{ if([r.title,r.docType,r.provider,r.facility,r.summary,r.myNotes,r.docDate].join(' ').toLowerCase().includes(q)) res.push({type:'Record', label:r.title, sub:`${r.docType}${r.docDate?' • '+App.formatDate(r.docDate):''}`, tab:'records', recId:r.id}); });
      App.state.screenings.forEach(s=>{ if((s.date||'').includes(q)) res.push({type:'Screening', label:`Screening ${App.formatDate(s.date)}`, sub:`AUDIT ${s.auditScore} / PHQ ${s.phqScore} / GAD ${s.gadScore}`, tab:'analytics'}); });
      return res.slice(0,10);
    },
    renderResults(matches, container){
      if(matches.length===0){ container.innerHTML = `<div class="p-4 text-center text-slate-400 text-sm">No matches found</div>`; return; }
      container.innerHTML = matches.map(m=>`<button onclick="${m.recId?`App.records.open('${m.recId}')`:`App.ui.nav('${m.tab}')`}" class="w-full text-left p-4 hover:bg-slate-50 dark:hover:bg-slate-700/50 border-b border-slate-50 dark:border-slate-700/50 last:border-0 transition-colors"><div class="text-[10px] font-bold uppercase tracking-widest text-primary-500">${m.type}</div><div class="font-bold text-sm">${m.label}</div><div class="text-xs text-slate-400 truncate">${m.sub}</div></button>`).join('');
    }
  },

  transport: {
