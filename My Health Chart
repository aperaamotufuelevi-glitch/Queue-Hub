    },
    // Generates a document code from the CURRENT date + 24-hour clock time,
    // plus a random suffix. Every call — i.e. every time something is printed —
    // reads a fresh `new Date()`, so the code (and therefore the barcode drawn
    // from it) is different on every print, even if printed twice in the same
    // minute. The random suffix guards against two prints landing in the same
    // second.
    generateBarcodeCode(prefix){
      const now = new Date();
      const pad = n=>String(n).padStart(2,'0');
      const y = now.getFullYear(), m = pad(now.getMonth()+1), d = pad(now.getDate());
      const H = pad(now.getHours()); // getHours() is already 24-hour
      const Min = pad(now.getMinutes()), S = pad(now.getSeconds());
      const rand = Math.floor(100 + Math.random()*900);
      return `${prefix}-${y}${m}${d}-${H}${Min}${S}-${rand}`;
    },
    // Renders `code` as a scan-line style barcode graphic. The bar/gap widths
    // are derived deterministically from the code's characters, so the same
    // code always draws the same bars, but a different code (new date/time/
    // random suffix on every print) always draws a visibly different pattern.
    barcodeSVG(code){
      const barHeight = 42, unit = 2.1;
      const widths = [];
      for(let i=0;i<code.length;i++){
        const c = code.charCodeAt(i);
        widths.push(1 + (c % 4));        // bar width: 1-4 units
        widths.push(1 + ((c >> 2) % 3));  // gap width: 1-3 units
      }
      let x = 0, bars = '';
      widths.forEach((w,i)=>{
        if(i % 2 === 0){ bars += `<rect x="${(x*unit).toFixed(1)}" y="0" width="${(w*unit).toFixed(1)}" height="${barHeight}" fill="#000"/>`; }
        x += w;
      });
      const totalWidth = Math.max(1,(x*unit)).toFixed(1);
      return `<div style="display:inline-block;text-align:center;">
        <svg width="${totalWidth}" height="${barHeight}" viewBox="0 0 ${totalWidth} ${barHeight}" xmlns="http://www.w3.org/2000/svg" style="display:block;background:#fff;">${bars}</svg>
        <div style="font-family:'Courier New',monospace;font-size:8px;letter-spacing:1.5px;color:#1a1a1a;margin-top:2px;white-space:nowrap;">${code}</div>
      </div>`;
    },
    // Convenience wrapper: generate a fresh code + its barcode graphic together,
    // for any print builder that just needs to stamp a unique doc ID.
    freshBarcodeBlock(prefix){
      const code = this.generateBarcodeCode(prefix);
      return this.barcodeSVG(code);
    },
