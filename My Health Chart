  data: {
    OLD_KEYS: { health:'home_health_vault_v1', rides:'hopelink_rides_v2', logs:'hopelink_logs_v2', profile:'hopelink_profile_v1', doctors:'hopelink_doctors_v1' },
    // Saves ONLY medication-doctor links, as their own small, independent
    // JSON blob under App.doctorLinksKey - completely separate from the
    // main combined save. Shape: { [medicationId]: {doctorId, doctorName} }.
    async saveDoctorLinks(){
      const links = {};
      App.state.medications.forEach(m=>{
        if(m.doctorId || m.doctorName){ links[m.id] = { doctorId: m.doctorId||'', doctorName: m.doctorName||'' }; }
      });
      return await PersistentStore.set(App.doctorLinksKey, JSON.stringify(links));
    },
    // Loads medication-doctor links from their separate store and applies
    // them onto App.state.medications by id. Called after the main load()
    // completes, so this can independently restore links even if something
    // about the main combined blob doesn't carry them through correctly.
    // Deliberately a ONE-WAY fallback: only fills in a link when the main
    // state is missing one (m.doctorId is empty) - it never overrides a
    // doctor that's already present from the main blob. This guarantees
    // the separate backup can never overwrite a correct, newer value with
    // a stale one, even in theory.
    async loadDoctorLinks(){
      try{
        const raw = await PersistentStore.get(App.doctorLinksKey);
        if(!raw) return;
        const links = JSON.parse(raw);
        App.state.medications.forEach(m=>{
          if(m.doctorId) return; // main blob already has a doctor - leave it alone
          const link = links[m.id];
          if(link && link.doctorId){ m.doctorId = link.doctorId; m.doctorName = link.doctorName||''; }
        });
      } catch(e){ console.error('loadDoctorLinks failed:', e); }
    },
    async load(){
      // 1) Try whichever backend PersistentStore currently treats as primary
      //    (the platform's persistent store if available, else this browser's
      //    localStorage) under the app's current key.
      let loaded = false;
      const saved = await PersistentStore.get(App.storageKey);
      if(saved){
        try{ const parsed = JSON.parse(saved); App.state = this.deepMerge(App.state, parsed); loaded = true; }
        catch(e){ console.error('Unified data corrupted in primary store - will check the other storage backend next.'); }
      }
      // 2) SAFETY NET - do not remove this without a very good reason.
      //    Which backend counts as "primary" can change between sessions (it
      //    already has once: this app used to have a bug that permanently
      //    stuck it on localStorage even when the platform's persistent store
      //    was available; after that bug was fixed, a session that now sees
      //    the platform store available looks there FIRST - and if nothing
      //    was ever saved there before, it looks completely empty even though
      //    real data still exists in localStorage under this exact same key).
      //    To make that kind of storage-location mismatch impossible to
      //    silently present as "your data is gone", ALWAYS also check the
      //    OTHER backend under the same current key when the primary lookup
      //    above came up empty, and adopt whichever one actually has data.
      //    This can only ever pull data IN - it never deletes or overwrites
      //    anything, and if it recovers data it immediately re-saves so both
      //    backends agree going forward instead of flapping between them.
      if(!loaded){
        try{
          const localRaw = safeStorage.getItem(App.storageKey);
          if(localRaw){
            const parsedLocal = JSON.parse(localRaw);
            App.state = this.deepMerge(App.state, parsedLocal);
            loaded = true;
            console.warn('Recovered data from localStorage - the platform persistent store was empty for this key. Re-saving to sync both.');
          }
        } catch(e){ console.error('Fallback localStorage read/parse failed:', e); }
      }
      if(!loaded && typeof window !== 'undefined' && window.storage && typeof window.storage.get === 'function'){
        try{
          const res = await window.storage.get(App.storageKey, false);
          if(res && typeof res.value === 'string'){
            const parsedRemote = JSON.parse(res.value);
            App.state = this.deepMerge(App.state, parsedRemote);
            loaded = true;
            console.warn('Recovered data from the platform persistent store - localStorage was empty for this key. Re-saving to sync both.');
          }
        } catch(e){ /* nothing saved there either - fine, not an error */ }
      }
      if(loaded){
        await this.save(true);
        this.normalizeDoctorIds();
        return;
      }
      // Legacy localStorage-key migration (old pre-unification key names from
      // even earlier app versions) - only relevant if NEITHER current-key
      // location above had anything at all.
      this.migrateLegacy();
      this.normalizeDoctorIds();
    },
    // Older/imported doctor records can carry a numeric id (matching the old
    // pre-migration format) instead of the 'doctor-<timestamp>' string id this
    // app now uses everywhere. A numeric id silently breaks edit/delete because
    // those look the record up with strict (===) comparison against a string
    // pulled from the button's onclick attribute. Coercing every id to a string
    // once on load fixes existing data permanently, in addition to the
    // String()-based comparisons used at edit/delete time as a second safeguard.
    normalizeDoctorIds(){
      if(!Array.isArray(App.state.doctors)) return;
      let changed = false;
      const cleaned = App.state.doctors.filter(d=>{
        const ok = d && typeof d === 'object';
        if(!ok) changed = true;
        return ok;
      });
      cleaned.forEach(d=>{
        if(d.id !== undefined && d.id !== null && typeof d.id !== 'string'){ d.id = String(d.id); changed = true; }
      });
      App.state.doctors = cleaned;
      if(changed) this.save();
    },
    deepMerge(base, incoming){
      const out = JSON.parse(JSON.stringify(base));
      Object.keys(incoming||{}).forEach(k=>{
        if(k==='profile' && incoming.profile){ out.profile = Object.assign({}, out.profile, incoming.profile); }
        else { out[k] = incoming[k]; }
      });
      return out;
    },
    migrateLegacy(){
      let migrated = false;
      try {
        const hv = safeStorage.getItem(this.OLD_KEYS.health);
        if(hv){
          const p = JSON.parse(hv);
          if(p.profile) App.state.profile = Object.assign({}, App.state.profile, p.profile);
          if(Array.isArray(p.vitals)) App.state.vitals = p.vitals;
          if(Array.isArray(p.medications)) App.state.medications = p.medications;
          if(Array.isArray(p.conditions)) App.state.conditions = p.conditions;
          if(Array.isArray(p.allergies)) App.state.allergies = p.allergies;
          if(Array.isArray(p.devices)) App.state.devices = p.devices;
          if(Array.isArray(p.doctors)) App.state.doctors = (App.state.doctors||[]).concat(p.doctors);
          if(p.settings) App.state.settings = Object.assign({}, App.state.settings, p.settings);
          migrated = true;
        }
        const rd = safeStorage.getItem(this.OLD_KEYS.rides);
        if(rd){ const r = JSON.parse(rd); if(Array.isArray(r)) App.state.rides = r; migrated = true; }
        const lg = safeStorage.getItem(this.OLD_KEYS.logs);
        if(lg){ const l = JSON.parse(lg); if(Array.isArray(l)) App.state.logs = l; migrated = true; }
        const pr = safeStorage.getItem(this.OLD_KEYS.profile);
        if(pr){
          const hp = JSON.parse(pr);
          if(hp && hp.name){
            const parts = hp.name.trim().split(' ');
            if(!App.state.profile.firstName) App.state.profile.firstName = parts[0]||'';
            if(!App.state.profile.lastName) App.state.profile.lastName = parts.slice(1).join(' ')||'';
          }
          if(hp){
            App.state.profile.cardNum = App.state.profile.cardNum || hp.cardNum || '';
            App.state.profile.providerOneNumber = App.state.profile.cardNum;
            App.state.profile.dob = App.state.profile.dob || hp.dob || '';
            App.state.profile.phone = App.state.profile.phone || hp.phone || '';
            App.state.profile.homeAddr = hp.homeAddr || App.state.profile.address || '';
            App.state.profile.address = App.state.profile.address || hp.homeAddr || '';
          }
          migrated = true;
        }
        const dc = safeStorage.getItem(this.OLD_KEYS.doctors);
        if(dc){
          const dl = JSON.parse(dc);
          if(Array.isArray(dl)){
            dl.forEach(d=>{
              const exists = App.state.doctors.find(x=>x.name && d.name && x.name.toLowerCase()===d.name.toLowerCase());
              if(!exists) App.state.doctors.push(Object.assign({specialty:'',email:''}, d));
            });
          }
          migrated = true;
        }
      } catch(e){ console.error('Migration error', e); }
      if(migrated){
        this.save();
        Object.values(this.OLD_KEYS).forEach(k=>safeStorage.removeItem(k));
        App.ui.toast && setTimeout(()=>App.ui.toast('Migrated existing data into the unified record'),300);
      }
    },
    async save(silent){
      App.state.profile.homeAddr = App.state.profile.address;
      App.state.profile.providerOneNumber = App.state.profile.cardNum;
      // Stamp of when this state was last saved, used by githubSync.pullOnLoad()
      // to decide whether a remote copy on another device is newer than this
      // one (and should be pulled in) or older (and should be left alone).
      if(!App.state.settings) App.state.settings = {};
      App.state.settings.lastSavedAt = new Date().toISOString();
      const ok = await PersistentStore.set(App.storageKey, JSON.stringify(App.state));
      const sync = document.getElementById('sync-status');
      if(ok){
        if(sync) sync.classList.remove('hidden');
      } else {
        if(sync) sync.classList.add('hidden');
        if(!silent){
          // This branch previously could never be reached for a quota
          // failure specifically (see safeStorage.setItem's fix above) -
          // it's the ONE message that should appear the moment storage is
          // actually full, instead of a false "Synced" indicator.
          const reason = (typeof safeStorage!=='undefined' && safeStorage.__writeReason) || '';
          const isQuota = /quota/i.test(reason);
          const msg = isQuota
            ? 'Storage is full — this change was NOT saved. Export a backup now (Settings → Export All Data), then free up space to keep saving new changes.'
            : 'Save failed — your last change may not persist. Try again or export a backup.';
          App.ui.toast(msg, 'error');
        }
      }
      // Fires (debounced) regardless of the local PersistentStore result above -
      // if GitHub sync is configured it can serve as a real backup even on a
      // device where local storage itself is degraded or blocked.
      App.githubSync.pushDebounced();
      return ok;
    },
    async freeUpSpace(){
      const before = App.state.logs.length;
      if(before <= 20){ App.ui.toast('Activity log is already small (' + before + ' entries) — there is nothing more to trim here.'); return; }
      App.state.logs = App.state.logs.slice(0, 20);
      const ok = await this.save();
      if(ok){
        App.ui.toast('Trimmed activity log from ' + before + ' to 20 entries to free up space. Try saving your change again.');
        if(App.transport && App.transport.renderLogs) App.transport.renderLogs();
        if(App.transport && App.transport.renderStats) App.transport.renderStats();
      } else {
        App.ui.toast('Trimmed the log, but storage is still too full to save. Export a backup, then use Reset All Data and re-import a trimmed copy.', 'error');
      }
    },
    async reset(){
      if(confirm('Are you absolutely sure? All records (health, transportation, and screenings) will be deleted forever.')){
        if(confirm('This is the last warning. Proceed with wipe?')){
          await PersistentStore.remove(App.storageKey);
          // If GitHub sync is connected, also overwrite the remote file with
          // an empty state. Without this, the very next load's pullOnLoad()
          // would see the (still-intact) remote copy as "newer" than this
          // now-empty device and quietly restore everything - breaking the
          // "cannot be undone" promise this button makes. Uses a fresh empty
          // object rather than the in-memory App.state, which still holds
          // the pre-wipe data at this point.
          if(App.githubSync.isConfigured()){
            const empty = { profile:{}, vitals:[], medications:[], conditions:[], allergies:[], devices:[], doctors:[], rides:[], logs:[], screenings:[], records:[], settings:{ darkMode:false, accent:'blue', lastSavedAt: new Date().toISOString() } };
            try{ await App.githubSync.pushStateObject(empty, true); } catch(e){}
          }
          location.reload();
        }
      }
    },
    exportJSON(){
      const blob = new Blob([JSON.stringify(App.state,null,2)],{type:'application/json'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `UnifiedHealthSystem_Backup_${new Date().toISOString().split('T')[0]}.json`; a.click();
    },
    async importJSON(data){
      App.state = this.deepMerge(App.state, data);
      await this.save();
      location.reload();
    }
  },

  // ============================================================
  // githubSync
  // ------------------------------------------------------------
  // Cross-device sync layer, separate from PersistentStore above.
  // PersistentStore (window.storage / localStorage) only ever lives on ONE
  // device/browser - that's the entire reason data doesn't show up when
  // this file is opened somewhere else. This module pushes a JSON copy of
  // App.state to a file in a GitHub repo the user owns, and pulls it back
  // down on load, so the same file opened on a different device converges
  // on the same data instead of starting empty.
  //
  // The token + repo config is intentionally stored ONLY in this browser's
  // own localStorage (configKey below), never inside App.state - so it is
  // never bundled into Export All Data or written into the synced file
  // itself. Each device needs it entered once, on purpose: it's a
  // credential, not data to replicate.
  // ============================================================
  githubSync: {
    configKey: 'unified_health_system_github_sync_v1',
    defaultConfig(){ return { token:'', owner:'', repo:'', path:'health-data/myhealthchart-data.json', branch:'main', autoSync:true, lastSyncedAt:'', lastError:'' }; },
    getConfig(){
      try{ const raw = safeStorage.getItem(this.configKey); return raw ? Object.assign(this.defaultConfig(), JSON.parse(raw)) : this.defaultConfig(); }
      catch(e){ return this.defaultConfig(); }
    },
    saveConfig(cfg){ try{ safeStorage.setItem(this.configKey, JSON.stringify(cfg)); } catch(e){} },
    isConfigured(){ const c = this.getConfig(); return !!(c.token && c.owner && c.repo && c.path); },
    toB64(str){ return btoa(unescape(encodeURIComponent(str))); },
    fromB64(b64){ return decodeURIComponent(escape(atob(String(b64).replace(/\n/g,'')))); },
    apiFileUrl(c){ return `https://api.github.com/repos/${encodeURIComponent(c.owner)}/${encodeURIComponent(c.repo)}/contents/${c.path.split('/').map(encodeURIComponent).join('/')}`; },
    async apiGetFile(){
      const c = this.getConfig();
      const res = await fetch(this.apiFileUrl(c) + '?ref=' + encodeURIComponent(c.branch||'main'), {
        headers: { 'Authorization':'Bearer ' + c.token, 'Accept':'application/vnd.github+json' }
      });
      if(res.status === 404) return { exists:false, sha:null, data:null };
      if(!res.ok) throw new Error('GitHub error ' + res.status + ' fetching file (check token/repo/path)');
      const json = await res.json();
      let data = null;
      try{ data = JSON.parse(this.fromB64(json.content||'')); } catch(e){ /* empty/corrupt file - treat as no data yet */ }
      return { exists:true, sha: json.sha, data };
    },
    async apiPutFile(dataObj, sha, c){
      c = c || this.getConfig();
      const body = { message: 'MyHealthChart sync — ' + new Date().toISOString(), content: this.toB64(JSON.stringify(dataObj, null, 2)), branch: c.branch||'main' };
      if(sha) body.sha = sha;
      const res = await fetch(this.apiFileUrl(c), {
        method:'PUT',
        headers: { 'Authorization':'Bearer ' + c.token, 'Accept':'application/vnd.github+json', 'Content-Type':'application/json' },
        body: JSON.stringify(body)
      });
      if(!res.ok) throw new Error('GitHub error ' + res.status + ' saving file (check token permissions)');
      return await res.json();
    },
    // Pushes an arbitrary state object (used directly by reset(), which needs
    // to push an EMPTY object rather than whatever is still sitting in the
    // in-memory App.state at that point).
    async pushStateObject(stateObj, silent){
      if(!this.isConfigured()) return false;
      const c = this.getConfig();
      try{
        const existing = await this.apiGetFile();
        await this.apiPutFile(stateObj, existing.sha, c);
        c.lastSyncedAt = new Date().toISOString(); c.lastError = ''; this.saveConfig(c);
        this.renderStatus();
        return true;
      } catch(e){
        c.lastError = (e && e.message) || 'Unknown error'; this.saveConfig(c);
        this.renderStatus();
        if(!silent) App.ui.toast('GitHub sync failed: ' + c.lastError, 'error');
        return false;
      }
    },
    async pushNow(silent){ return this.pushStateObject(App.state, silent); },
    _pushTimer: null,
    // Debounced so a burst of rapid saves (e.g. typing across several
    // fields) doesn't fire one GitHub API call per keystroke - only the
    // last save in a ~2s window actually triggers a push.
    pushDebounced(){
      const c = this.getConfig();
      if(!this.isConfigured() || c.autoSync===false) return;
      clearTimeout(this._pushTimer);
      this._pushTimer = setTimeout(()=>this.pushNow(true), 2000);
    },
    // Called once on startup. Compares timestamps and adopts whichever copy
    // was saved more recently, so a device that's behind catches up instead
    // of silently overwriting newer work from elsewhere with its own stale
    // copy. (This is a single-user, one-active-device-at-a-time design -
    // editing the same record on two devices at the same time before
    // syncing can still lose one side's change, same as any simple sync
    // setup like this.)
    async pullOnLoad(){
      if(!this.isConfigured()) return;
      const c = this.getConfig();
      try{
        const remote = await this.apiGetFile();
        if(remote.exists && remote.data){
          const localTime = (App.state.settings && App.state.settings.lastSavedAt) || '';
          const remoteTime = (remote.data.settings && remote.data.settings.lastSavedAt) || '';
          if(!localTime || remoteTime >= localTime){
            App.state = App.data.deepMerge(App.state, remote.data);
            await App.data.save(true);
          }
        }
        c.lastSyncedAt = new Date().toISOString(); c.lastError = ''; this.saveConfig(c);
      } catch(e){
        c.lastError = (e && e.message) || 'Unknown error'; this.saveConfig(c);
      }
    },
    // Manual "Sync Now" button: pulls first (so this device catches up),
    // then pushes (so this device's just-pulled state - and this is the
    // only place either side gets written - is confirmed back to GitHub),
    // then re-renders every tab so pulled-in changes are visible immediately
    // instead of only appearing after a manual page refresh.
    async syncNow(){
      if(!this.isConfigured()){ App.ui.toast('Fill in the token, owner, and repository first, then Save & Connect.', 'error'); return; }
      App.ui.toast('Syncing with GitHub…', 'info');
      await this.pullOnLoad();
      const ok = await this.pushNow(false);
      ['vitals','meds','analytics','profile','doctors','conditions','allergies','devices','dashboard'].forEach(m=>{ try{ App[m].render(); } catch(e){} });
      if(ok) App.ui.toast('GitHub sync complete.');
    },
    async handleSaveConnect(){
      const cfg = {
        token: document.getElementById('gh-token-input').value.trim(),
        owner: document.getElementById('gh-owner-input').value.trim(),
        repo: document.getElementById('gh-repo-input').value.trim(),
        path: document.getElementById('gh-path-input').value.trim() || 'health-data/myhealthchart-data.json',
        branch: document.getElementById('gh-branch-input').value.trim() || 'main',
        autoSync: document.getElementById('gh-autosync-select').value !== 'manual',
        lastSyncedAt: this.getConfig().lastSyncedAt || '',
        lastError: ''
      };
      if(!cfg.token || !cfg.owner || !cfg.repo){ App.ui.toast('Token, owner, and repository name are all required.', 'error'); return; }
      this.saveConfig(cfg);
      try{
        const res = await fetch('https://api.github.com/repos/' + encodeURIComponent(cfg.owner) + '/' + encodeURIComponent(cfg.repo), {
          headers: { 'Authorization':'Bearer ' + cfg.token, 'Accept':'application/vnd.github+json' }
        });
        if(!res.ok) throw new Error(res.status===404 ? 'Repository not found (check owner/repo spelling and that the token can access it)' : ('GitHub error ' + res.status + ' checking repository'));
        const repoJson = await res.json();
        if(repoJson.private === false){
          App.ui.toast('Connected — but this repository is PUBLIC. Anyone with the link could read your health data. Consider switching to a private repo.', 'error');
        } else {
          App.ui.toast('Connected to GitHub.');
        }
        await this.syncNow();
      } catch(e){
        cfg.lastError = (e && e.message) || 'Connection failed'; this.saveConfig(cfg);
        App.ui.toast('GitHub connection failed: ' + cfg.lastError, 'error');
        this.renderStatus();
      }
    },
    disconnect(){
      App.ui.confirmDialog('Disconnect GitHub sync on THIS device? This only clears the saved token here — it does not delete anything from GitHub.').then(yes=>{
        if(!yes) return;
        this.saveConfig(this.defaultConfig());
        this.renderStatus();
        App.ui.toast('GitHub sync disconnected on this device.');
      });
    },
    renderStatus(){
      const el = document.getElementById('github-sync-status');
      if(!el) return;
      const c = this.getConfig();
      const setVal = (id,val)=>{ const node = document.getElementById(id); if(node && document.activeElement!==node) node.value = val; };
      setVal('gh-token-input', c.token||'');
      setVal('gh-owner-input', c.owner||'');
      setVal('gh-repo-input', c.repo||'');
      setVal('gh-path-input', c.path||'health-data/myhealthchart-data.json');
      setVal('gh-branch-input', c.branch||'main');
