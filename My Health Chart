        ${statsHtml}
        ${trendDetailHtml}
        ${chartsHtml}`;
    },
    // Builds the actual line-chart images for whichever print-chart-* canvases
    // are currently in #print-area. Uses the most recent 30 vitals readings
    // (chronological) to match the "Last 30 Readings" heading above. Must be
    // called AFTER the HTML containing those canvases has been injected into
    // the DOM (i.e. from doPrint's callback), and BEFORE window.print() fires.
    renderPrintCharts(){
      if(typeof Chart==='undefined') return;
      const v = this.reportVitals().slice(0,30).slice().reverse();
      if(v.length===0) return;
      const labels = v.map(x=>App.formatDate(x.date));
      const commonOpts = { responsive:false, animation:false, plugins:{legend:{labels:{font:{size:9}}}}, scales:{ x:{ticks:{font:{size:8}}}, y:{ticks:{font:{size:8}}} } };
      const bpCanvas = document.getElementById('print-chart-bp');
      if(bpCanvas){
        new Chart(bpCanvas, { type:'line', data:{ labels, datasets:[
          { label:'Systolic', data:v.map(x=>x.systolic), borderColor:'#ef4444', backgroundColor:'rgba(239,68,68,.12)', fill:true, tension:.3, pointRadius:2 },
          { label:'Diastolic', data:v.map(x=>x.diastolic), borderColor:'#22c55e', backgroundColor:'rgba(34,197,94,.12)', fill:true, tension:.3, pointRadius:2 }
        ]}, options: commonOpts });
