.vc-legend i{width:9px;height:9px;border-radius:2px;display:inline-block;margin-right:4px}
/* overflow:hidden + a hard canvas width/height constraint are a CSS-level
   safety net for the chart: Chart.js's responsive:true sizing is JS-driven
   (a ResizeObserver measures this wrapper and sets the canvas's size to
   match), so on the very first paint - or any time that measurement runs
   before the 2-column grid has settled its track widths - the canvas can
   briefly report its native default intrinsic size (300x150) instead of
   this wrapper's actual size. Without min-width:0 on .vc-card, a grid item
   can be forced wider than its track by that oversized child, and without
   this canvas rule, the oversized canvas paints past .vc-chart-wrap's own
   170px box - both together are what make one card's chart bleed into the
   next card. Pinning the canvas to 100%/100% here means it always matches
   this wrapper regardless of Chart.js's own timing, and overflow:hidden
   clips anything that still doesn't. */
.vc-chart-wrap{height:170px;position:relative;margin:6px 0 2px;overflow:hidden}
.vc-chart-wrap canvas{width:100% !important;height:100% !important}
.vc-empty{display:flex;align-items:center;justify-content:center;height:170px;color:#94a3b8;font-size:12px;text-align:center}
.vc-footer{font-size:10.5px;color:#94a3b8;border-top:1px solid #f1f5f9;padding-top:10px;margin-top:6px}
.dark .vc-footer{border-color:#334155;color:#64748b}
.vc-footer b{color:#475569;font-weight:700}
.dark .vc-footer b{color:#cbd5e1}
/* Fallback (same reasoning as the loading-overlay/modal rule above): keep these
   two grid containers' own hidden elements collapsed even if the Tailwind CDN
   fails to load, without touching the generic .hidden class used elsewhere. */
#dash-vitalcards-grid .hidden, #analytics-vitalcards-grid .hidden{ display:none !important; }

