      // FIX (confirmed via direct testing): the Prescribing Doctor select's
      // options are injected dynamically by populateDoctorSelect() rather
      // than written statically in the HTML. Real-browser testing showed
      // this field could fail to round-trip through the generic
      // Object.fromEntries(new FormData(...)) capture above, even though it
      // displayed correctly selected on screen right up until save - while
      // every other field on this same form, including the other <select>
      // (Insurance Status), correctly persisted through the exact same
      // save/reload cycle. Reading .value directly from the element is a
      // more direct, unambiguous capture that doesn't depend on FormData's
      // handling of a dynamically-populated select, and can only help.
      const doctorSelectEl = document.getElementById('med-doctor-select');
      if(doctorSelectEl) entry.doctorId = doctorSelectEl.value;
