      if(entry.refillDate){ const d = new Date(entry.refillDate+'T00:00:00'); d.setDate(d.getDate()+cycleDays); entry.nextRefillDate = d.toISOString().split('T')[0]; }
      // Snapshot the doctor's name at selection time (in addition to the
      // live doctorId link) - this fixes "the doctor I picked disappeared":
      // if that doctor is ever deleted and re-added later, they get a brand
      // new id, which breaks the id-only reference. The name snapshotted
      // here stays correct regardless of what happens to the doctor record
      // afterward.
      if(entry.doctorId){
