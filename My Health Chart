    importData(event){
      const file = event.target.files[0]; if(!file) return;
      const reader = new FileReader();
      reader.onload = (e)=>{
        try{
          const data = JSON.parse(e.target.result);
          if(data.rides && Array.isArray(data.rides)) App.state.rides = data.rides;
          if(data.logs && Array.isArray(data.logs)) App.state.logs = data.logs;
          if(data.doctors && Array.isArray(data.doctors)) App.state.doctors = data.doctors;
          if(data.profile) App.state.profile = Object.assign({}, App.state.profile, data.profile);
          App.data.save(); this.renderTable(); this.renderLogs(); App.doctors.render(); App.profile.render();
          this.log('import', null, null, 'Imported transportation data');
          App.ui.toast('Import successful!');
        } catch(err){ alert('Invalid JSON file.'); }
      };
      reader.readAsText(file); event.target.value='';
    }
