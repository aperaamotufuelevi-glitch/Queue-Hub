      }
      const fullHomeAddress = App.getFullHomeAddress() || 'Not set';
      // Every physical page of the report is one entry in this array (plain
      // content, no page wrapper yet) - built up here, then each entry is
      // run through printPageHTML() once at the very end so every page gets
      // identical treatment (the fixed-size .print-page box + one
      // disclaimer footer pinned to its bottom). Lists that could grow
      // arbitrarily long (rides, screenings) are split into as many chunks
      // as they need via chunkArray() rather than forced onto one page.
      const pages = [];

      // ============================================================
      // Page 1: "Home Health Summary Report" cover page - built to match
      // a specific reference design: header + report-period box, patient
      // info grid, 3 vital cards (BP/SpO2/Temp - Heart Rate moves into the
      // Pulse column of the readings table instead of its own card, matching
      // the reference exactly), a Detailed Readings table + Overview panel
      // side by side, then Lifestyle/Important/Devices columns, then a
      // footer with signature line and tip banner. Everything on one page.
      // ============================================================
      const age = p.dob ? Math.floor((new Date() - new Date(p.dob))/31557600000) : null;
      const reportStartDate = win ? win.start : (v.length ? v[v.length-1].date : null);
      const reportEndDate = win ? win.end : (v.length ? v[0].date : null);
      const dayCount = (reportStartDate && reportEndDate) ? Math.max(1, Math.round((new Date(reportEndDate+'T00:00:00') - new Date(reportStartDate+'T00:00:00'))/86400000) + 1) : null;

      const tempC = r => (parseFloat(r.temp)-32)*5/9;
      const vitalCardsRow = ['bp','spo2','temp'].map(k=>this.vitalCardPrintHTML('prc-'+k, k)).join('');

      pages.push(`<div style="padding:16px;box-sizing:border-box;font-family:system-ui,-apple-system,sans-serif;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;gap:12px;">
          <div style="flex:1;"><h1 style="font-size:22px;font-weight:900;color:#0f172a;margin:0;line-height:1.15;">Home Health Summary Report</h1><p style="font-size:11px;color:#64748b;margin:2px 0 0 0;">Personal Health Report for Doctor Review</p></div>
          <div style="border:1px solid #e2e8f0;border-radius:10px;padding:8px 14px;text-align:center;min-width:150px;flex-shrink:0;"><div style="font-size:8px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em;">Report Period</div><div style="font-size:11px;font-weight:700;color:#0f172a;margin-top:2px;">${reportStartDate?App.formatDateShort(reportStartDate):'--'} – ${reportEndDate?App.formatDateShort(reportEndDate):'--'}</div><div style="font-size:9px;color:#64748b;margin-top:1px;">${dayCount?`(${dayCount} Day${dayCount===1?'':'s'})`:''}</div></div>
          <div style="padding:6px 10px;border:1px solid #e2e8f0;border-radius:8px;flex-shrink:0;">${this.freshBarcodeBlock('RPT')}</div>
        </div>
        <div style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 14px;margin-bottom:12px;display:flex;gap:14px;align-items:flex-start;">
          <div style="width:36px;height:36px;border-radius:50%;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:#3b82f6;font-size:16px;flex-shrink:0;overflow:hidden;">${p.photo?`<img src="${p.photo}" style="width:100%;height:100%;object-fit:cover;">`:'<i class="fa-solid fa-user"></i>'}</div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px 20px;flex:1;font-size:9.5px;">
            <div><b>Name:</b> ${p.firstName} ${p.lastName}</div><div><b>Date of Birth:</b> ${p.dob?App.formatDate(p.dob):'DD-MMM-YYYY'}</div><div><b>Report Generated On:</b> ${today}</div>
            <div><b>Age / Gender:</b> ${age!==null?age:'XX'} / ${p.gender||'X'}</div><div><b>Contact:</b> ${p.phone||'--'}</div><div><b>Prepared By:</b> Self</div>
            <div><b>Height:</b> ${p.heightRaw||'--'}</div><div><b>Blood Type:</b> ${p.bloodType||'--'}</div><div><b>Insurance:</b> ${p.insurance||'--'}</div>
            <div><b>Weight:</b> ${p.weightRaw||'--'} ${p.weightUnit||''}</div><div><b>ProviderOne Number:</b> ${p.cardNum||'--'}</div><div><b>Home Address:</b> ${fullHomeAddress}</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;">${vitalCardsRow}</div>
        <div style="margin-bottom:12px;">${this.readingsTableHTML(tableRows.slice(0,10), win, tableRows.length, false)}</div>
      </div>`);
      // Any readings beyond the first 10 continue on their own page(s) at
      // the same large, readable size instead of being dropped.
      this.chunkArray(tableRows.slice(10), 24).forEach(chunk=>{
        pages.push(`<div style="padding:16px;box-sizing:border-box;font-family:system-ui,-apple-system,sans-serif;">${this.readingsTableHTML(chunk, win, tableRows.length, true)}</div>`);
      });

      // Page(s): Active Medications side-by-side with Patient Assessment.
      // FIX for "medication list prints on top of the disclaimer": a long
      // medication list (many entries, each with a multi-line description)
      // could exceed one fixed-height .print-page, and since the footer is
      // absolutely positioned against that page's own bottom edge (see
      // .print-page-footer in the stylesheet), overflowing content doesn't
      // push the footer down - it prints UNDER/THROUGH it instead. Rides and
      // Screening History already guard against this with chunkArray(); this
      // page never did.
      // Per explicit request: keep the original two-column layout (meds
      // left, Patient Assessment right) rather than switching to a
      // different full-width format for overflow - both columns continue
      // together onto as many pages as the medication list needs. The
      // Patient Assessment box repeats on every page (not just the last)
      // so the layout stays visually identical page to page. Chunked at a
      // SMALLER count per page than a full-width list would use, because
      // this column is only half the page width, so the same description
      // text wraps across more lines and each entry takes noticeably more
      // vertical room - 5 is a conservative estimate with real safety
      // margin against the exact overflow this fix exists to prevent;
      // adjust downward if a page still ever runs long, upward if there's
      // consistently a lot of empty space.
      // ============================================================
      // Active Medications print row - clinical table layout.
      // Columns: Medication | Dose | Directions | Physician | Insurance | Refill.
      // Grid (not a real <table>) so each medication is one self-contained,
      // independently measurable unit for paginateBySize() below, while
      // still keeping columns aligned across every row via fixed
      // grid-template-columns (shared by the header row too).
      //
      // Physician Approval Status: this app has no field, and no way to
