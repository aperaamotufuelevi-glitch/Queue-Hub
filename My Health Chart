    },
    // Standalone print of the Refill Alerts section, invoked from the dashboard
    // card's own "Print" button - opens the print dialog with just this section
    // (patient header + full medication refill table) on its own page(s).
    // Prints one Notes & Records entry as complete, properly paginated pages
    // (same fixed-size .print-page + footer system as every other report).
    // The whole record is broken into small blocks - one per summary
    // paragraph / table row - and packed with paginateBySize(), so a long
    // summary or a long lab list flows onto extra pages instead of running
    // into the disclaimer footer.
    printRecord(id){
      const r = App.records.get(id); if(!r) return;
      const e = v=>App.records.esc(v);
      const p = App.state.profile;
      const H = t=>`<h3 style="font-size:12px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-left:3px solid #2563eb;padding-left:8px;margin:14px 0 6px 0;">${t}</h3>`;
      const row = (cols, cells, head)=>`<div style="display:grid;grid-template-columns:${cols};gap:6px;padding:5px 8px;font-size:${head?'8px':'9px'};${head?'background:#1e40af;color:#fff;font-weight:700;text-transform:uppercase;':'border-bottom:1px solid #e2e8f0;color:#1a1a1a;'}">${cells.map(c=>`<div>${c}</div>`).join('')}</div>`;
      const blocks = [];
      const table = (title, cols, heads, rows)=>{ if(!rows.length) return; blocks.push(H(title)+row(cols, heads, true)); rows.forEach(rr=>blocks.push(row(cols, rr, false))); };
      blocks.push(`<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;font-size:9.5px;border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;">
        <div><b>Type:</b> ${e(r.docType)}</div><div><b>Date:</b> ${r.docDate?App.formatDate(r.docDate):'--'}</div><div><b>Time:</b> ${r.docTime?App.formatTime(r.docTime):'--'}</div>
        <div><b>Provider:</b> ${e(r.provider||'--')}</div><div><b>Facility:</b> ${e(r.facility||'--')}</div><div><b>Patient:</b> ${e(r.patientName || (p.firstName+' '+p.lastName))}</div>
        <div style="grid-column:span 3;"><b>Source file:</b> ${e(r.fileName||'--')} • <b>Uploaded:</b> ${App.formatLogTime(r.uploadedAt)}</div></div>`);
      const paras = (r.summary||'').split(/\n\s*\n/).filter(x=>x.trim());
      paras.forEach((pp,i)=>blocks.push((i===0?H('Full Summary'):'')+`<p style="font-size:10px;line-height:1.55;margin:0 0 7px 0;color:#1a1a1a;">${e(pp.trim()).replace(/\n/g,'<br>')}</p>`));
      if(r.keyFindings.length){ r.keyFindings.forEach((k,i)=>blocks.push((i===0?H('Key Findings'):'')+`<div style="font-size:10px;padding:2px 0 2px 12px;">• ${e(k)}</div>`)); }
      const steps = r.nextSteps;
      table('Next Steps', '2.6fr 1fr 1.2fr .8fr', ['Task','Category','Due','Status'], steps.map(s=>[`<b>${e(s.task)}</b>${(s.provider||s.location||s.notes)?`<div style="font-size:8px;color:#64748b;">${e([s.provider,s.location,s.notes].filter(Boolean).join(' • '))}</div>`:''}`, e(s.category), e([s.dueDate?App.formatDateShort(s.dueDate):'', s.dueTime?App.formatTime(s.dueTime):''].filter(Boolean).join(' ')||'—'), e((App.records.STEP_STATUS[s.status]||{}).label||s.status)]));
      table('Medications', '1.4fr .8fr 1.8fr 1.5fr 1fr', ['Medication','Dose','Directions','Purpose','Prescriber'], r.medications.map(m=>[`<b>${e(m.name)}</b>`, e([m.dose,m.route].filter(Boolean).join(' ')||'—'), e([m.frequency,m.instructions].filter(Boolean).join(' — ')||'—'), e(m.purpose||'—')+(String(m.purposeSource).toLowerCase()==='inferred'?' (likely)':''), e(m.doctorName||'—')]));
      table('Lab Results', '1.6fr 1.1fr 1.2fr .6fr .9fr', ['Test','Result','Reference','Flag','Date'], r.labs.map(l=>[`<b>${e(l.test)}</b>`, e((l.result||'')+' '+(l.unit||'')), e(l.referenceRange||'—'), e(l.flag||'—'), e(l.date||'—')]));
      table('Vitals Recorded', '1.2fr .9fr .7fr .7fr .7fr 1.6fr', ['Date / Time','BP','Pulse','SpO2','Temp','Other'], r.vitals.map(v=>[e([v.date,v.time].filter(Boolean).join(' ')||'—'), e(v.systolic&&v.diastolic?v.systolic+'/'+v.diastolic:'—'), e(v.heartRate||'—'), e(v.spo2||'—'), e(v.temp||'—'), e([v.weight?'Wt '+v.weight:'',v.notes].filter(Boolean).join(' • ')||'—')]));
      table('Diagnoses / Conditions', '2fr 1.5fr 1fr 1fr', ['Condition','Codes','Date','Priority'], r.conditions.map(c=>[`<b>${e(c.name)}</b>`, e([c.icd10,c.icd9].filter(Boolean).join(' / ')||'—'), e(c.date||'—'), e(c.priority||'—')]));
      table('Allergies', '2fr 1fr 2fr', ['Allergen','Severity','Reaction'], r.allergies.map(a=>[`<b>${e(a.name)}</b>`, e(a.severity||'—'), e(a.reaction||'—')]));
      table('Procedures', '1.6fr 1fr 1.6fr 1.6fr', ['Procedure','Date','Result','Notes'], r.procedures.map(x=>[`<b>${e(x.name)}</b>`, e(x.date||'—'), e(x.result||'—'), e(x.notes||'—')]));
      if(r.instructions.length){ r.instructions.forEach((k,i)=>blocks.push((i===0?H('Instructions'):'')+`<div style="font-size:10px;padding:2px 0 2px 12px;">• ${e(k)}</div>`)); }
      table('Providers & Contacts Named', '1.5fr 1fr 2fr 1.4fr', ['Name','Specialty','Clinic / Address','Contact'], r.doctors.map(d=>[`<b>${e((d.title||'')+' '+(d.name||''))}</b>`, e(d.specialty||'—'), e([d.clinic,d.address].filter(Boolean).join(', ')||'—'), e([d.phone,d.email].filter(Boolean).join(' • ')||'—')]));
      table('All Other Information', '1.3fr 3fr', ['Detail','Value'], r.allOtherInformation.map(o=> typeof o==='object' ? [`<b>${e(o.label)}</b>`, e(o.value)] : ['', e(o)]));
      if(r.myNotes){ blocks.push(H('My Notes')+`<p style="font-size:10px;line-height:1.5;margin:0;white-space:pre-wrap;">${e(r.myNotes)}</p>`); }

      const heading = `<div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #2563eb;padding-bottom:8px;margin-bottom:10px;gap:10px;">
          <div><h1 style="font-size:18px;font-weight:900;color:#1e3a8a;margin:0;line-height:1.2;">${e(r.title)}</h1><p style="font-size:10px;color:#64748b;margin:2px 0 0 0;">Medical Document Record • ${e(p.firstName+' '+p.lastName)} • Printed ${new Date().toLocaleDateString()}</p></div>
          <div style="padding:4px 8px;border:1px solid #e2e8f0;border-radius:6px;flex-shrink:0;">${this.freshBarcodeBlock('DOC')}</div></div>`;
      const contHeading = `<h1 style="font-size:14px;font-weight:900;color:#1e3a8a;border-bottom:2px solid #2563eb;padding-bottom:6px;margin:0 0 8px 0;">${e(r.title)} (continued)</h1>`;
      const chunks = this.paginateBySize(blocks, b=>b, heading, null);
      const pages = chunks.map((chunk,ci)=>`<div style="padding:16px;box-sizing:border-box;">${ci===0?heading:contHeading}${chunk.join('')}</div>`);
      this.doPrint(pages.map((pg,i)=>this.printPageHTML(pg, i+1, pages.length)).join(''));
      App.transport.log('print', null, r.title, 'Printed document record');
    },
    printRefillAlerts(){
      const html = this.printPageHTML(this.refillAlertsHTML(true));
      this.doPrint(html);
      App.transport.log('print', null, null, 'Printed refill alerts');
    },
    printAll(){
      // healthReportHTML(true, true) includes everything: vitals, meds,
      // refill alerts, health analytics (with the print-chart-* canvases),
      // conditions/allergies/doctor directory, the full ride history + a
      // detail sheet per ride, AND the SBIRT screening history - each
      // already its own properly paginated .print-page with the disclaimer
      // footer, so there's no need to duplicate the screening-history
      // markup here the way this used to.
      this._reportVitals = null; this._reportWindow = null;
      const html = this.healthReportHTML(true, true);
      this.doPrint(html, ()=>{ this.renderPrintVitalCards('prc', 15); this.renderPrintCharts(); });
      App.transport.log('print', null, null, 'Printed complete medical file');
    }
  }
};

window.onload = () => App.init();
</script>
</body>
</html>
