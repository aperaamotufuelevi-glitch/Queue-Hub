/* ===== Vital Cards (Blood Pressure / Heart Rate / SpO2 / Temperature) - namespaced "vc-" =====
   Every number shown here (average / min / max / footer) and every plotted line point is
   read from the SAME underlying values array in App.charts - see the JS module below. */
.vc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media (max-width:820px){.vc-grid{grid-template-columns:1fr}}
.vc-card{background:#fff;border-radius:20px;border:1px solid #e2e8f0;padding:18px 20px;box-shadow:0 1px 3px rgba(0,0,0,.06);min-width:0}
.dark .vc-card{background:#1e293b;border-color:#334155}
.vc-header{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.vc-icon{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;color:#fff;flex-shrink:0}
.vc-title{font-weight:700;font-size:14px;line-height:1.25}
.vc-unit{font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;font-weight:700}
.vc-statrow{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:12px;flex-wrap:wrap}
.vc-avg-label{font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:2px}
.vc-avg-value{font-size:26px;font-weight:800;line-height:1;white-space:nowrap}
.vc-avg-sub{font-size:10px;color:#94a3b8;margin-top:3px}
.vc-side-stats{text-align:right;font-size:11px;color:#64748b;line-height:1.7;white-space:nowrap}
.dark .vc-side-stats{color:#94a3b8}
.vc-side-stats b{font-weight:700;color:#334155}
.dark .vc-side-stats b{color:#e2e8f0}
.vc-legend{display:flex;gap:14px;font-size:11px;margin-bottom:4px;color:#64748b}
