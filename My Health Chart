    getAllAddresses(){
      const addresses = new Set();
      if(App.state.profile.address) addresses.add(App.state.profile.address);
      App.state.doctors.forEach(d=>{ if(d.address) addresses.add(d.address); });
      App.state.rides.forEach(r=>{ [r.puAddr,r.doAddr,r.retPuAddr,r.retDoAddr].forEach(a=>{ if(a) addresses.add(a); }); });
      return Array.from(addresses);
    },
    // Root cause of the provider dropdown misbehaving: initAddressAutocompletes()
    // re-runs every time the ride form is opened (showForm/editRide), and it used
    // to call addEventListener() fresh each time WITHOUT removing the previous
    // listeners. Every re-open piled another duplicate 'input'/'keydown'/'click'
    // listener onto the same fields, and after a few opens they started fighting
    // each other (one clearing the list a beat after another just rendered it) -
    // which looks exactly like "the dropdown isn't showing." The `data-ac-bound`
    // guard below makes setup idempotent: each field is wired exactly once no
    // matter how many times the form is opened.
    setupAddressAutocomplete(inputId, suggestionsId){
      const input = document.getElementById(inputId); const suggestionsBox = document.getElementById(suggestionsId);
      if(!input||!suggestionsBox) return;
      if(input.dataset.acBound==='1') return; // already wired - don't double-attach
      input.dataset.acBound = '1';
      let currentFocus = -1;
      function render(matches){
        closeAllLists();
        if(matches.length===0) return;
        suggestionsBox.innerHTML=''; suggestionsBox.classList.remove('hidden');
        matches.forEach(addr=>{
          const div = document.createElement('div'); div.className='tr-addr-suggestion-item';
          div.textContent = addr;
          div.addEventListener('mousedown', function(ev){ ev.preventDefault(); input.value = addr; closeAllLists(); const ev2 = new Event('change'); input.dispatchEvent(ev2); });
          suggestionsBox.appendChild(div);
        });
      }
      input.addEventListener('focus', function(){
        const val = this.value.trim();
        const all = App.transport.getAllAddresses();
        const matches = (val ? all.filter(a=>a.toLowerCase().includes(val.toLowerCase())) : all).slice(0,8);
        render(matches);
      });
      input.addEventListener('input', function(){
        const val = this.value.trim();
        if(!val){ render(App.transport.getAllAddresses().slice(0,8)); return; }
        const matches = App.transport.getAllAddresses().filter(a=>a.toLowerCase().includes(val.toLowerCase())).slice(0,8);
        render(matches);
      });
      input.addEventListener('keydown', function(e){
        const items = suggestionsBox.querySelectorAll('.tr-addr-suggestion-item');
        if(e.key==='ArrowDown'){ currentFocus++; addActive(items); e.preventDefault(); }
        else if(e.key==='ArrowUp'){ currentFocus--; addActive(items); e.preventDefault(); }
        else if(e.key==='Enter'){ e.preventDefault(); if(currentFocus>-1 && items[currentFocus]) items[currentFocus].dispatchEvent(new Event('mousedown')); }
        else if(e.key==='Escape'){ closeAllLists(); }
      });
      function addActive(items){ if(!items||!items.length) return; removeActive(items); if(currentFocus>=items.length) currentFocus=0; if(currentFocus<0) currentFocus=items.length-1; items[currentFocus].style.background='#eff6ff'; }
      function removeActive(items){ for(let i=0;i<items.length;i++) items[i].style.background=''; }
      function closeAllLists(){ suggestionsBox.innerHTML=''; suggestionsBox.classList.add('hidden'); currentFocus=-1; }
      document.addEventListener('click', function(e){ if(e.target!==input && !suggestionsBox.contains(e.target)) closeAllLists(); });
    },
    initAddressAutocompletes(){
      ['rf-puAddr:puAddrSuggestions','rf-doAddr:doAddrSuggestions','rf-retPuAddr:retPuAddrSuggestions','rf-retDoAddr:retDoAddrSuggestions'].forEach(pair=>{
        const [inputId, sugId] = pair.split(':'); this.setupAddressAutocomplete(inputId, sugId);
      });
      this.setupProviderAutocomplete();
    },
    setupProviderAutocomplete(){
      const input = document.getElementById('rf-provider'); const suggestionsBox = document.getElementById('providerSuggestions');
      if(!input||!suggestionsBox) return;
      if(input.dataset.acBound==='1') return; // already wired - don't double-attach (see note above)
      input.dataset.acBound = '1';
      let currentFocus=-1;
      function matchesFor(val){
        const list = App.state.doctors.filter(d=>d && d.name);
        if(!val) return list.slice(0,8);
        return list.filter(d=>d.name.toLowerCase().includes(val.toLowerCase())).slice(0,8);
      }
      function render(val, matches){
        closeAllLists();
        if(App.state.doctors.filter(d=>d && d.name).length===0){
          suggestionsBox.innerHTML = '<div class="tr-addr-suggestion-item" style="color:#94a3b8;cursor:default;">No doctors saved yet — add one in the Directory tab first</div>';
          suggestionsBox.classList.remove('hidden');
          return;
        }
        if(matches.length===0){
          suggestionsBox.innerHTML = '<div class="tr-addr-suggestion-item" style="color:#94a3b8;cursor:default;">No matching doctor found</div>';
          suggestionsBox.classList.remove('hidden');
          return;
        }
        suggestionsBox.innerHTML=''; suggestionsBox.classList.remove('hidden');
        matches.forEach(doc=>{
          const div = document.createElement('div'); div.className='tr-addr-suggestion-item tr-provider-suggestion-item';
          const li = val ? doc.name.toLowerCase().indexOf(val.toLowerCase()) : -1;
          const nameHtml = li>=0 ? doc.name.substring(0,li)+'<span class="tr-addr-suggestion-match">'+doc.name.substring(li,li+val.length)+'</span>'+doc.name.substring(li+val.length) : doc.name;
          // Show the FULL record on file for this doctor - name, specialty, clinic,
          // address, phone - not just a truncated name+clinic snippet, so the
          // person can confirm they're picking the right provider before selecting.
          const rows = [];
          if(doc.specialty) rows.push('<i class="fa-solid fa-stethoscope"></i> '+doc.specialty);
          if(doc.clinic) rows.push('<i class="fa-solid fa-hospital"></i> '+doc.clinic);
          if(doc.address) rows.push('<i class="fa-solid fa-location-dot"></i> '+doc.address);
          if(doc.phone) rows.push('<i class="fa-solid fa-phone"></i> '+doc.phone);
          div.innerHTML = `<div style="font-weight:700;font-size:14px;color:#1e3a5f;">${doc.title||'Dr.'} ${nameHtml}</div>` +
            (rows.length ? `<div style="margin-top:3px;font-size:12px;color:#64748b;line-height:1.6;">${rows.join('<br>')}</div>` : '');
          div.addEventListener('mousedown', function(ev){ ev.preventDefault(); input.value = doc.name; input.dataset.doctorId = doc.id; closeAllLists(); App.transport.onProviderSelect(); });
          suggestionsBox.appendChild(div);
        });
      }
      input.addEventListener('focus', function(){ const val=this.value.trim(); render(val, matchesFor(val)); });
      input.addEventListener('input', function(){ const val=this.value.trim(); render(val, matchesFor(val)); });
      input.addEventListener('keydown', function(e){
        const items = suggestionsBox.querySelectorAll('.tr-addr-suggestion-item');
        if(e.key==='ArrowDown'){ currentFocus++; addActive(items); e.preventDefault(); }
        else if(e.key==='ArrowUp'){ currentFocus--; addActive(items); e.preventDefault(); }
        else if(e.key==='Enter'){ e.preventDefault(); if(currentFocus>-1 && items[currentFocus]) items[currentFocus].dispatchEvent(new Event('mousedown')); }
        else if(e.key==='Escape'){ closeAllLists(); }
      });
      function addActive(items){ if(!items||!items.length) return; removeActive(items); if(currentFocus>=items.length) currentFocus=0; if(currentFocus<0) currentFocus=items.length-1; items[currentFocus].style.background='#eff6ff'; }
      function removeActive(items){ for(let i=0;i<items.length;i++) items[i].style.background=''; }
      function closeAllLists(){ suggestionsBox.innerHTML=''; suggestionsBox.classList.add('hidden'); currentFocus=-1; }
      document.addEventListener('click', function(e){ if(e.target!==input && !suggestionsBox.contains(e.target)) closeAllLists(); });
    },
