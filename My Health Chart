          <div>
            <h3 style="font-size:11px;font-weight:700;margin:0 0 6px 0;text-transform:uppercase;color:#475569;">Upcoming Rides</h3>
            ${upcoming.length? upcoming.map(r=>`<div style="font-size:9px;padding:5px 0;border-bottom:1px solid #f1f5f9;"><b>${r.name}</b> — ${App.formatDateShort(r.apptDate)} • ${r.provider||'No provider'} <span style="text-transform:uppercase;color:#64748b;">(${r.status})</span></div>`).join('') : '<p style="font-size:9px;color:#94a3b8;">No upcoming rides scheduled.</p>'}
          </div>
        </div>
        <div>
          <h3 style="font-size:11px;font-weight:700;margin:0 0 6px 0;text-transform:uppercase;color:#92400e;">Refill Alerts</h3>
          ${needsRefill.length? `<table style="width:100%;border-collapse:collapse;font-size:9px;"><thead><tr style="background:#fffbeb;"><th style="padding:4px;text-align:left;color:#1a1a1a;">Medication</th><th style="padding:4px;text-align:left;color:#1a1a1a;">Next Refill</th><th style="padding:4px;text-align:left;color:#1a1a1a;">Status</th></tr></thead><tbody>
            ${needsRefill.map(m=>{ const t=m.nextRefillDate||m.refillDate; const diff=Math.ceil((new Date(t+'T00:00:00')-today)/86400000); const label = diff<0?'OVERDUE':(diff===0?'Due today':diff+'d left'); const meta = App.meds.STATUS_META[m.refillStatus||'none'] || App.meds.STATUS_META.none; return `<tr><td style="padding:4px;border-bottom:1px solid #fde68a;">${m.name}</td><td style="padding:4px;border-bottom:1px solid #fde68a;">${App.formatDate(t)} (${label})</td><td style="padding:4px;border-bottom:1px solid #fde68a;">${meta.label}</td></tr>`; }).join('')}
          </tbody></table>` : '<p style="font-size:9px;color:#94a3b8;">No refill alerts.</p>'}
        </div>
      </div>`);
      this.doPrint(html, ()=>{
        if(typeof Chart==='undefined') return;
        const canvas = document.getElementById('print-dash-chart'); if(!canvas) return;
        const recent = App.state.vitals.slice(0,10).slice().reverse();
        if(recent.length===0) return;
        const labels = recent.map(v=>App.formatDate(v.date));
        new Chart(canvas, { type:'line', data:{ labels, datasets:[
          { label:'Systolic', data:recent.map(v=>parseInt(v.systolic)||0), borderColor:'#ef4444', tension:.3, pointRadius:2 },
