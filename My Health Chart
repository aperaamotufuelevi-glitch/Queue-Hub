    // .print-page-footer in the print stylesheet), so the meta line and the
    // disclaimer move together as a single fixed unit and neither can drift
    // independently of the other. pageNum/totalPages default to 1/1 for
    // print jobs that are always a single page.
    pageFooterHTML(pageNum, totalPages){
      const dateLabel = new Date().toLocaleDateString();
      return `<div class="print-page-footer">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
          <span style="font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;">Home Health Vitals & Vitals Tracking & Summary • ${dateLabel}</span>
          <span style="font-size:8px;font-weight:700;color:#94a3b8;white-space:nowrap;">Page ${pageNum||1} of ${totalPages||1}</span>
        </div>
        <p style="font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:#475569;margin:0 0 3px 0;">Disclaimer</p>
        <p style="font-size:8px;color:#475569;line-height:1.35;margin:0;">I am not a doctor or medical professional, and this document is not a clinical record or medical diagnosis. This is a self-tracked, at-home log I am keeping to help monitor and share my own health information with my care team. Please verify any readings, medications, or other details independently before relying on them for clinical decisions.</p>
      </div>`;
    },
    // Wraps ONE page's worth of content into a complete .print-page: a
    // fixed 8.5in x 11in box (see print stylesheet) with the footer
    // (pageFooterHTML above) placed inside it, absolutely positioned
    // against that same box's own bottom edge. Every print job is built by
    // collecting an array of page-content strings (one per physical page)
    // and mapping each one through this function, passing the page's own
    // 1-based index and the array's total length so the footer can show
    // "Page X of Y" - callers should never hand-roll a page-break div or
    // call pageFooterHTML() directly; go through here so every page gets
    // the exact same treatment. pageNum/totalPages can be omitted for a
    // print job that's always exactly one page.
    printPageHTML(contentHtml, pageNum, totalPages){
      return `<div class="print-page">${contentHtml}${this.pageFooterHTML(pageNum, totalPages)}</div>`;
    },
    // Splits an array into groups of at most `size` items - used to spread
    // a list that could grow arbitrarily long (ride history, screening
    // history) across as many fixed-size pages as it actually needs,
    // instead of trying to force it all onto one page and risking content
    // being clipped by that page's overflow:hidden.
    chunkArray(arr, size){
      const out = [];
      for(let i=0;i<arr.length;i+=size) out.push(arr.slice(i, i+size));
      return out;
    },
    // Packs medications into pages by ACTUALLY MEASURING rendered height at
    // print scale, instead of guessing a fixed count per page (which either
    // wastes space when rows are short, or - the original bug this whole
    // feature started from - overflows into the disclaimer when rows are
    // long). Builds one hidden, real .print-page-shaped element (same CSS
    // classes/structure the real printed page uses, including the
    // side-by-side grid with the medication list on the left and the
    // Patient Assessment box on the right), then greedily appends one
    // medication row at a time and checks the LEFT column's actual
    // scrollHeight against the page's actual available content height
    // (measured from the SAME .print-page/inner padding rules the real
    // print stylesheet uses, so it can't drift out of sync with it) -
    // closing out a page and starting a new one the moment the next row
    // would no longer fit.
    //
    // rowHTMLFn(med) -> HTML string for one medication's row.
    // assessmentHTML -> HTML string for the Patient Assessment box (right
    //   column), which is measured once and repeated unchanged into every
    //   page - its own height is what's left over after the medication
    //   column, so as long as the medication column fits, so does this.
    //
    // Defensive design (do not remove): if measurement ever comes back as
    // 0/NaN - which would happen if this ever runs somewhere without real
    // layout, or before the page has finished rendering - this falls back
    // to the previous fixed-count-per-page behavior (SAFE_FALLBACK_PER_PAGE)
    // rather than trusting a broken measurement, since a wrong "everything
    // fits on one page" conclusion would silently reintroduce the original
    // overflow-onto-the-disclaimer bug.
    paginateBySize(items, rowHTMLFn, headingHTML, asideHTML){
      const SAFE_FALLBACK_PER_PAGE = 5;
      const HEIGHT_SAFETY_MARGIN = 0.94; // use 94% of the measured budget, leaving margin for font-metric differences between measurement and final print
      const HARD_MAX_PER_PAGE = 40; // generous backstop - only meant to guard against a truly broken measurement, not to cap realistic medication counts

      if(items.length === 0) return [[]];
      if(typeof document === 'undefined'){
        return this.chunkArray(items, SAFE_FALLBACK_PER_PAGE);
      }

      let probe, inner, availableHeight;
      try{
        probe = document.createElement('div');
        probe.className = 'print-page';
        // FIX: .print-page's real width:8.5in/height:11in/padding rules only
        // apply inside @media print (see the print stylesheet) - but this
        // measurement runs during normal on-screen JS execution, BEFORE
        // window.print() puts the page into print media. Relying on the
        // className alone meant this probe had NO real size at all outside
        // of an active print context, so it always measured ~0px and fell
        // through to the safety fallback below - every single time, in
        // every real browser. That's the actual reason every page was
        // getting a flat 5 items regardless of true available space. Fix:
        // set the exact same numbers directly as inline styles, which
        // apply unconditionally regardless of media context.
        probe.style.cssText = 'position:fixed; left:-9999px; top:0; visibility:hidden; pointer-events:none; width:8.5in; height:11in; box-sizing:border-box; padding:.3in .3in 1.25in .3in; overflow:hidden; font-family:system-ui,-apple-system,sans-serif;';
        document.body.appendChild(probe);
        inner = document.createElement('div');
        inner.style.cssText = 'padding:16px; box-sizing:border-box; height:100%;';
        probe.appendChild(inner);
        availableHeight = inner.clientHeight;
      } catch(e){ availableHeight = 0; }

      if(!availableHeight || isNaN(availableHeight) || availableHeight < 50){
        // Measurement didn't work in this environment - don't guess further, use the known-safe fallback.
        if(probe && probe.parentNode) probe.parentNode.removeChild(probe);
        return this.chunkArray(items, SAFE_FALLBACK_PER_PAGE);
      }
      const budget = availableHeight * HEIGHT_SAFETY_MARGIN;

      const grid = document.createElement('div');
      grid.style.cssText = asideHTML ? 'display:grid; grid-template-columns:1fr 1fr; gap:16px;' : 'display:block;';
      inner.appendChild(grid);
      const leftCol = document.createElement('div');
      grid.appendChild(leftCol);
      if(asideHTML){
        const rightCol = document.createElement('div');
        rightCol.innerHTML = asideHTML;
        grid.appendChild(rightCol);
      }
      const headingEl = document.createElement('div');
      headingEl.innerHTML = headingHTML;
      leftCol.appendChild(headingEl);

      const chunks = [];
      let current = [];
      items.forEach(item=>{
        const rowEl = document.createElement('div');
        rowEl.innerHTML = rowHTMLFn(item);
        leftCol.appendChild(rowEl);
        const fits = leftCol.scrollHeight <= budget;
        if(!fits && current.length > 0){
          leftCol.removeChild(rowEl);
          chunks.push(current);
          current = [item];
          leftCol.innerHTML = '';
          leftCol.appendChild(headingEl.cloneNode(true));
          const freshRow = document.createElement('div');
          freshRow.innerHTML = rowHTMLFn(item);
          leftCol.appendChild(freshRow);
        } else {
          current.push(item);
        }
        if(current.length >= HARD_MAX_PER_PAGE){
          chunks.push(current);
          current = [];
          leftCol.innerHTML = '';
          leftCol.appendChild(headingEl.cloneNode(true));
        }
      });
      if(current.length) chunks.push(current);
      probe.parentNode.removeChild(probe);
      return chunks.length ? chunks : [[]];
    },
    // Renders the same "Refill Alerts" list shown on the Dashboard (every
    // medication that has a tracked refill date, overdue/due-soon highlighted)
    // so refill status is part of the printed record, not just the in-app view.
    // standalone=true adds a patient-identity header + barcode so this section
    // can be printed (or appear inside the full report) as its own complete
    // page, not just a bare table. The Status column now reads from the SAME
    // App.meds.STATUS_META table used on-screen (Dashboard + Medications tab),
    // including the "Received" state and its receivedDate when set, so the
    // printed record always matches what the app currently shows.
    refillAlertsHTML(standalone){
      const today = new Date(); today.setHours(0,0,0,0);
      const list = App.state.medications
        .filter(m=> !!(m.nextRefillDate||m.refillDate))
        .sort((a,b)=> new Date((a.nextRefillDate||a.refillDate)+'T00:00:00') - new Date((b.nextRefillDate||b.refillDate)+'T00:00:00'));
      const rows = list.map(m=>{
        const t = m.nextRefillDate||m.refillDate;
        const diff = Math.ceil((new Date(t+'T00:00:00')-today)/86400000);
        const dueLabel = diff<0 ? `OVERDUE (${Math.abs(diff)}d)` : (diff===0 ? 'Due today' : `${diff}d left`);
        const dueColor = diff<0 ? '#991b1b' : (diff<=7 ? '#92400e' : '#166534');
        const statusKey = m.refillStatus || 'none';
        const meta = App.meds.STATUS_META[statusKey] || App.meds.STATUS_META.none;
        const status = meta.label + (statusKey==='received' && m.refillDate ? ` (${App.formatDateShort(m.refillDate)})` : '');
        return `<tr><td style="padding:6px;border-bottom:1px solid #fde68a;font-weight:700;">${m.name}</td><td style="padding:6px;border-bottom:1px solid #fde68a;">${m.dose||'-'}</td><td style="padding:6px;border-bottom:1px solid #fde68a;">${App.formatDate(t)}</td><td style="padding:6px;border-bottom:1px solid #fde68a;font-weight:700;color:${dueColor};">${dueLabel}</td><td style="padding:6px;border-bottom:1px solid #fde68a;">${status}</td></tr>`;
      }).join('');
      const table = list.length ? `<table style="width:100%;border-collapse:collapse;font-size:10px;table-layout:fixed;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;overflow:hidden;">
          <thead><tr style="background:#f59e0b;color:#fff;"><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;width:25%;">Medication</th><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;width:15%;">Dose</th><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;width:18%;">Next Refill</th><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;width:17%;">Days</th><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;width:25%;">Status</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>` : `<p style="font-size:10px;color:#94a3b8;">No medications currently have a tracked refill date.</p>`;
      if(!standalone){
        if(list.length===0) return '';
        return `<div style="margin-bottom:20px;">
          <h3 style="font-size:14px;font-weight:900;color:#92400e;margin:0 0 8px 0;border-left:3px solid #f59e0b;padding-left:8px;text-transform:uppercase;">Refill Alerts</h3>
          ${table}
        </div>`;
      }
      const p = App.state.profile;
      const fullName = `${p.firstName} ${p.lastName}`.trim() || 'Health Vault User';
      return `<div style="padding:16px;color:#1a1a1a;background:#fff;font-family:system-ui,-apple-system,sans-serif;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #f59e0b;padding-bottom:10px;margin-bottom:14px;">
          <div><h1 style="font-size:20px;font-weight:900;color:#92400e;text-transform:uppercase;margin:0;">Refill Alerts</h1><p style="font-size:11px;color:#64748b;margin:2px 0 0 0;">${fullName} • ${new Date().toLocaleDateString()}</p></div>
          <div style="padding:4px 8px;border:1px solid #e2e8f0;border-radius:6px;">${this.freshBarcodeBlock('RFL')}</div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px;">
          <div style="background:#f8fafc;padding:10px;border-radius:8px;"><p style="font-size:9px;font-weight:700;color:#94a3b8;text-transform:uppercase;margin:0 0 2px 0;">Patient</p><p style="font-size:12px;font-weight:700;margin:0;">${fullName}</p></div>
          <div style="background:#f8fafc;padding:10px;border-radius:8px;"><p style="font-size:9px;font-weight:700;color:#94a3b8;text-transform:uppercase;margin:0 0 2px 0;">DOB</p><p style="font-size:12px;font-weight:700;margin:0;">${p.dob?App.formatDate(p.dob):'--'}</p></div>
          <div style="background:#f8fafc;padding:10px;border-radius:8px;"><p style="font-size:9px;font-weight:700;color:#94a3b8;text-transform:uppercase;margin:0 0 2px 0;">Phone</p><p style="font-size:12px;font-weight:700;margin:0;">${p.phone||'--'}</p></div>
        </div>
        ${table}
      </div>`;
    },
    patientAssessmentBoxHTML(){
      return `<div style="background:#dcfce7;color:#14532d;padding:16px;border-radius:16px;border:2px solid #86efac;">
            <p style="font-size:10px;line-height:1.5;color:#166534;margin:0;">Patient has provided home readings for physician review. This data was collected using consumer-grade home monitoring devices. Physician should verify critical readings in-office.</p>
            <div style="margin-top:20px;border-top:1px solid #86efac;padding-top:20px;"><div style="height:1px;background:#14532d;width:120px;margin-bottom:4px;"></div><p style="font-size:9px;text-transform:uppercase;font-weight:700;color:#15803d;margin:0;">Physician Signature</p></div>
          </div>`;
    },
    healthAnalyticsHTML(){
      const v = this.reportVitals(); const win = this._reportWindow;
      let statsHtml = win ? `<p style="font-size:11px;color:#64748b;">No vital readings were recorded between ${App.formatDate(win.start)} and ${App.formatDate(win.end)}.</p>` : '<p style="font-size:10px;color:#94a3b8;">No vital readings logged yet.</p>';
      let trendDetailHtml = '';
      let chartsHtml = '';
      if(v.length){
        const avgSys = Math.round(v.reduce((a,b)=>a+parseInt(b.systolic),0)/v.length);
        const avgDia = Math.round(v.reduce((a,b)=>a+parseInt(b.diastolic),0)/v.length);
        const avgHR = Math.round(v.reduce((a,b)=>a+parseInt(b.heartRate),0)/v.length);
        const avgSpO2 = Math.round(v.reduce((a,b)=>a+parseInt(b.spo2),0)/v.length);
        const tempsAll = v.map(x=>parseFloat(x.temp)).filter(t=>!isNaN(t));
        const avgTemp = tempsAll.length ? (tempsAll.reduce((a,b)=>a+b,0)/tempsAll.length).toFixed(1) : '--';

        // Deterministic, metric-aware, reference-range-aware trend
        // calculation - see App.trendEngine above App.analytics. Replaces
        // the old "systolic average of the second half vs. the first
        // half" logic, which ignored SpO2, diastolic BP, heart rate, and
        // temperature entirely.
        const result = App.trendEngine.computeGeneralTrend(v);

        statsHtml = `<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
          <div style="background:#eff6ff;padding:10px;border-radius:8px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#2563eb;text-transform:uppercase;margin:0;">Avg Blood Pressure</p><p style="font-size:16px;font-weight:900;margin:2px 0 0 0;">${avgSys}/${avgDia}</p></div>
          <div style="background:#eff6ff;padding:10px;border-radius:8px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#2563eb;text-transform:uppercase;margin:0;">Avg Heart Rate</p><p style="font-size:16px;font-weight:900;margin:2px 0 0 0;">${avgHR} bpm</p></div>
          <div style="background:#eff6ff;padding:10px;border-radius:8px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#2563eb;text-transform:uppercase;margin:0;">Avg SpO2</p><p style="font-size:16px;font-weight:900;margin:2px 0 0 0;">${avgSpO2}%</p></div>
          <div style="background:#eff6ff;padding:10px;border-radius:8px;text-align:center;"><p style="font-size:9px;font-weight:700;color:#2563eb;text-transform:uppercase;margin:0;">Avg Temp</p><p style="font-size:16px;font-weight:900;margin:2px 0 0 0;">${avgTemp}°F</p></div>
        </div>`;

        // General Trend (the whole-period, rule-based verdict) and Recent
        // Direction (just the last reading vs. the one before it) are
