        banner.innerHTML = `<div class="flex items-start gap-3"><i class="fa-solid fa-file-circle-check text-emerald-600 text-2xl mt-0.5"></i><div>
            <p class="font-bold text-emerald-800 dark:text-emerald-300">Full record saved: ${esc(rec.title)}</p>
            <p class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5">${esc(rec.docType)}${rec.docDate?' • '+App.formatDate(rec.docDate):''}${rec.docTime?' • '+App.formatTime(rec.docTime):''} • Full-page summary, every detail found, and ${open} next step${open===1?'':'s'} being tracked.</p></div></div>
          <button onclick="App.records.open('${rec.id}')" class="px-4 py-2 bg-emerald-600 text-white rounded-xl font-bold text-sm whitespace-nowrap"><i class="fa-solid fa-folder-open mr-1"></i> View Full Record</button>`;
        wrap.appendChild(banner);
      }
      const totalPending = sections.reduce((a,s)=>a+this.pending[s.key].length,0);
      if(totalPending>1){
        const allBar = document.createElement('div');
        allBar.className = 'flex justify-end';
        allBar.innerHTML = `<button onclick="App.aiImport.saveEverything()" class="px-4 py-2 bg-emerald-600 text-white rounded-xl font-bold text-sm"><i class="fa-solid fa-check-double mr-1"></i> Add Everything (${totalPending})</button>`;
        wrap.appendChild(allBar);
      }
      sections.forEach(sec=>{
        const items = this.pending[sec.key];
        if(!items.length) return;
        const secDiv = document.createElement('div');
        secDiv.className = 'bg-white dark:bg-slate-800 rounded-3xl border border-slate-100 dark:border-slate-700 shadow-sm overflow-hidden';
        let cardsHtml = '';
        items.forEach((item, idx)=>{
          const err = this.validate(sec.key, item);
          const fieldsHtml = sec.fields.map(f=>{
            const missing = f.required && !String(item[f.name]||'').trim();
            const cls = 'form-input mt-1 text-sm' + (missing ? ' !border-rose-400 !bg-rose-50 dark:!bg-rose-900/20' : '');
            const wrapCls = f.wide ? 'md:col-span-2' : '';
            if(f.type==='select'){
              const opts = f.options.map(o=>`<option value="${o}" ${o===item[f.name]?'selected':''}>${o}</option>`).join('');
              return `<div class="${wrapCls}"><label class="text-[10px] font-bold text-slate-400 uppercase">${f.label}</label><select class="${cls}" onchange="App.aiImport.updateField('${sec.key}',${idx},'${f.name}',this.value)">${opts}</select></div>`;
            }
            const t = f.type || 'text';
            return `<div class="${wrapCls}"><label class="text-[10px] font-bold ${missing?'text-rose-500':'text-slate-400'} uppercase">${f.label}</label><input type="${t}" class="${cls}" value="${esc(item[f.name])}" ${t==='text'?`oninput`:`onchange`}="App.aiImport.updateField('${sec.key}',${idx},'${f.name}',this.value)"></div>`;
          }).join('');
          cardsHtml += `<div class="p-4 border-b border-slate-50 dark:border-slate-700 last:border-0">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">${fieldsHtml}</div>
              ${err?`<p class="text-xs font-semibold text-rose-600 mb-2"><i class="fa-solid fa-circle-exclamation mr-1"></i>${esc(err)}</p>`:''}
              <div class="flex gap-2 justify-end">
                <button onclick="App.aiImport.discardItem('${sec.key}',${idx})" class="px-3 py-1.5 text-xs font-bold rounded-lg border border-slate-200 dark:border-slate-600 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700">Discard</button>
                <button onclick="App.aiImport.saveItem('${sec.key}',${idx})" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-primary-600 text-white hover:bg-primary-700 ${err?'opacity-50':''}">Add to ${sec.label}</button>
              </div>
            </div>`;
        });
        secDiv.innerHTML = `<div class="p-6 border-b border-slate-50 dark:border-slate-700 flex items-center justify-between gap-3">
            <h3 class="font-bold flex items-center gap-2"><i class="fa-solid ${sec.icon} text-primary-500"></i> ${sec.label} found (${items.length})</h3>
            <button onclick="App.aiImport.saveAll('${sec.key}')" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 whitespace-nowrap">Add All</button>
          </div>
          <div>${cardsHtml}</div>`;
        wrap.appendChild(secDiv);
      });
      if(!totalPending && !rec){
        wrap.innerHTML = '<div class="text-center py-12 text-slate-400"><i class="fa-solid fa-inbox text-3xl mb-3"></i><p>Nothing pending review. Upload a document above to get started.</p></div>';
      }
    }
  },

  // ============================================================
  // NOTES & RECORDS
  // ------------------------------------------------------------
  // One saved record per uploaded document: document info (type, date,
  // time, facility, provider), a full-page summary, key findings, every
  // medication/lab/procedure/instruction found, an "All Other Information"
  // catch-all so nothing in the document is dropped, personal notes, and a
  // Next Steps tracker (status dropdown per step). The uploaded file itself
  // is NOT stored - only what was extracted - to keep storage small.
  // Lives in App.state.records, so it's included in Export / Import / GitHub
  // sync like everything else.
  // ============================================================
  records: {
    DOC_TYPES: ['After-Visit Summary','Discharge Summary','Lab Results','Imaging Report','Prescription / Medication List','Referral','Appointment Notice','Progress Note','Insurance / Benefits','Letter / Correspondence','Billing Statement','Other'],
    STEP_CATEGORIES: ['Appointment','Lab / Test','Medication','Referral','Call / Contact','Paperwork','Self-Care','Other'],
    STEP_STATUS: {
      pending:   { label:'To Do',     cls:'bg-amber-100 text-amber-700' },
      scheduled: { label:'Scheduled', cls:'bg-blue-100 text-blue-700' },
      done:      { label:'Done',      cls:'bg-emerald-100 text-emerald-700' },
      cancelled: { label:'Cancelled', cls:'bg-slate-100 text-slate-500' }
    },
    viewingId: null,
    esc(v){ return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); },
    isDate(s){ return /^\d{4}-\d{2}-\d{2}$/.test(String(s||'')); },
    isTime(s){ return /^\d{1,2}:\d{2}$/.test(String(s||'')); },
    newId(prefix){ return prefix+'-'+Date.now()+'-'+Math.random().toString(36).substr(2,5); },

    buildFromExtraction(parsed, fileName){
      const str = v => (v===undefined||v===null) ? '' : String(v).trim();
      const arr = v => Array.isArray(v) ? v.filter(x=>x!==null && x!==undefined && x!=='') : [];
      const d = parsed.document || {};
      const docType = this.DOC_TYPES.includes(str(d.type)) ? str(d.type) : 'Other';
      const docDate = this.isDate(str(d.date)) ? str(d.date) : '';
      const docTime = this.isTime(str(d.time)) ? str(d.time).padStart(5,'0') : '';
      const nextSteps = arr(parsed.nextSteps).map(s=>({
        id: this.newId('step'),
        task: str(s.task),
        category: this.STEP_CATEGORIES.includes(str(s.category)) ? str(s.category) : 'Other',
        dueDate: this.isDate(str(s.dueDate)) ? str(s.dueDate) : '',
        dueTime: this.isTime(str(s.dueTime)) ? str(s.dueTime).padStart(5,'0') : '',
        provider: str(s.provider), location: str(s.location), notes: str(s.notes),
        status: 'pending'
      })).filter(s=>s.task);
      return {
        id: this.newId('rec'),
        uploadedAt: new Date().toISOString(),
        fileName: fileName || '',
        docType, docDate, docTime,
        title: str(d.title) || (docType + (docDate?' — '+docDate:'')),
        facility: str(d.facility), provider: str(d.provider), patientName: str(d.patientName), pages: str(d.pages),
        summary: str(parsed.summary),
        keyFindings: arr(parsed.keyFindings).map(str),
        doctors: arr(parsed.doctors), medications: arr(parsed.medications), conditions: arr(parsed.conditions),
        allergies: arr(parsed.allergies), vitals: arr(parsed.vitals), labs: arr(parsed.labs),
        procedures: arr(parsed.procedures), instructions: arr(parsed.instructions).map(str),
        allOtherInformation: arr(parsed.allOtherInformation),
        nextSteps,
        myNotes: ''
      };
    },
    get(id){ return App.state.records.find(r=>r.id===id); },
    save(){ App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: change may not have saved — check your connection and try again.','error'); } }); },

    open(id){ this.viewingId = id; App.ui.nav('records'); },
    back(){ this.viewingId = null; this.render(); window.scrollTo(0,0); },

    openSteps(){
      const out = [];
      App.state.records.forEach(r=> r.nextSteps.forEach(s=>{ if(s.status==='pending'||s.status==='scheduled') out.push({ rec:r, step:s }); }));
      return out.sort((a,b)=> (a.step.dueDate||'9999') .localeCompare(b.step.dueDate||'9999') || (a.step.dueTime||'').localeCompare(b.step.dueTime||''));
    },
    dueLabel(step){
      if(!step.dueDate) return { text:'No due date', cls:'text-slate-400' };
      const today = new Date(); today.setHours(0,0,0,0);
      const diff = Math.round((new Date(step.dueDate+'T00:00:00')-today)/86400000);
      const when = App.formatDateShort(step.dueDate) + (step.dueTime?' '+App.formatTime(step.dueTime):'');
      if(diff<0) return { text: when+' — overdue', cls:'text-rose-600 font-bold' };
      if(diff===0) return { text: when+' — today', cls:'text-amber-600 font-bold' };
      if(diff<=7) return { text: when+` — in ${diff}d`, cls:'text-amber-600' };
      return { text: when, cls:'text-slate-500' };
    },

    setStepStatus(recId, stepId, status){
      const r = this.get(recId); if(!r) return;
      const s = r.nextSteps.find(x=>x.id===stepId); if(!s) return;
      s.status = status;
      this.save(); this.render(); App.dashboard.render();
    },
    updateStep(recId, stepId, field, value){
      const r = this.get(recId); if(!r) return;
      const s = r.nextSteps.find(x=>x.id===stepId); if(!s) return;
      s[field] = value; this.save();
    },
    deleteStep(recId, stepId){
      const r = this.get(recId); if(!r) return;
      App.ui.confirmDialog('Remove this next step?').then(yes=>{
        if(!yes) return;
        r.nextSteps = r.nextSteps.filter(x=>x.id!==stepId);
        this.save(); this.render(); App.dashboard.render();
      });
    },
    addStep(recId){
      const r = this.get(recId); if(!r) return;
      const task = (document.getElementById('rec-newstep-task')||{}).value||'';
      if(!task.trim()){ App.ui.toast('Enter the task first.','error'); return; }
      r.nextSteps.push({ id:this.newId('step'), task:task.trim(),
        category: document.getElementById('rec-newstep-cat').value,
        dueDate: document.getElementById('rec-newstep-date').value,
        dueTime: document.getElementById('rec-newstep-time').value,
        provider:'', location:'', notes:'', status:'pending' });
      this.save(); this.render(); App.dashboard.render();
      App.ui.toast('Next step added.');
    },
    updateField(recId, field, value){
      const r = this.get(recId); if(!r) return;
      r[field] = value; this.save();
    },
    delete(id){
      const r = this.get(id); if(!r) return;
      App.ui.confirmDialog(`Delete the record "${this.esc(r.title)}"? Items you already added to Medications, Doctors, etc. are not affected.`).then(yes=>{
        if(!yes) return;
        App.state.records = App.state.records.filter(x=>x.id!==id);
        if(this.viewingId===id) this.viewingId = null;
        App.transport.log('delete', null, r.title, 'Deleted document record');
        this.save(); this.render(); App.dashboard.render();
      });
    },
    // Opens the existing ride form with everything from an Appointment step
    // auto-filled (date, start time, provider -> phone/address, notes); the
    // form's own logic then calculates check-in and the pickup window.
    createRide(recId, stepId){
      const r = this.get(recId); const s = r && r.nextSteps.find(x=>x.id===stepId); if(!s) return;
      App.ui.nav('rides');
      App.transport.showForm();
      setTimeout(()=>{
        if(s.dueDate) document.getElementById('rf-apptDate').value = s.dueDate;
        if(s.dueTime){ document.getElementById('rf-apptStart').value = s.dueTime; App.transport.onStartTimeChange(); }
        const provName = (s.provider || r.provider || '').replace(/^dr\.?\s+/i,'').trim();
        if(provName){
          const doc = App.state.doctors.find(d=>d.name && (d.name.toLowerCase()===provName.toLowerCase() || d.name.toLowerCase().includes(provName.toLowerCase())));
          document.getElementById('rf-provider').value = doc ? doc.name : provName;
          App.transport.onProviderSelect();
        }
        document.getElementById('rf-notes').value = [s.task, s.location?('Location: '+s.location):'', s.notes].filter(Boolean).join(' — ');
        document.getElementById('rf-status').value = 'pending';
        s.status = 'scheduled'; this.save();
      }, 150);
    },

    // ---------- rendering ----------
    render(){
      const listWrap = document.getElementById('records-browse');
      const detail = document.getElementById('records-detail');
      if(!listWrap || !detail) return;
      const typeSel = document.getElementById('records-type-filter');
      if(typeSel && typeSel.options.length<=1){
        typeSel.innerHTML = '<option value="">All document types</option>' + this.DOC_TYPES.map(t=>`<option value="${t}">${t}</option>`).join('');
      }
      if(this.viewingId && this.get(this.viewingId)){
        listWrap.classList.add('hidden'); detail.classList.remove('hidden');
        detail.innerHTML = this.detailHTML(this.get(this.viewingId));
        return;
      }
      this.viewingId = null;
      listWrap.classList.remove('hidden'); detail.classList.add('hidden'); detail.innerHTML = '';
      this.renderStepsPanel();
      const q = ((document.getElementById('records-search')||{}).value||'').toLowerCase();
      const t = (typeSel||{}).value||'';
      const list = App.state.records.filter(r=>{
        if(t && r.docType!==t) return false;
        if(!q) return true;
        return [r.title,r.docType,r.provider,r.facility,r.summary,r.fileName,r.myNotes].join(' ').toLowerCase().includes(q);
      }).sort((a,b)=> (b.docDate||b.uploadedAt).localeCompare(a.docDate||a.uploadedAt));
      const grid = document.getElementById('records-list');
      const empty = document.getElementById('records-empty');
      if(!list.length){ grid.innerHTML=''; empty.classList.remove('hidden'); empty.querySelector('p').innerText = App.state.records.length ? 'No records match this filter.' : 'No records yet — upload a document on the AI Import tab.'; return; }
      empty.classList.add('hidden');
      grid.innerHTML = list.map(r=>{
        const open = r.nextSteps.filter(s=>s.status==='pending'||s.status==='scheduled').length;
        const excerpt = (r.summary||'').replace(/\s+/g,' ').slice(0,220) + ((r.summary||'').length>220?'…':'');
        return `<div class="bg-white dark:bg-slate-800 p-5 rounded-3xl border border-slate-100 dark:border-slate-700 shadow-sm flex flex-col gap-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0"><span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-primary-100 text-primary-700">${this.esc(r.docType)}</span>
              <h4 class="font-bold text-lg mt-1.5 leading-snug">${this.esc(r.title)}</h4>
