    toast(msg, type='success'){
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = { success:'bg-emerald-600', error:'bg-rose-600', info:'bg-primary-600' };
      toast.className = `${colors[type]} text-white px-6 py-3 rounded-2xl shadow-xl flex items-center gap-3 shadow-lg`;
      toast.innerHTML = `<i class="fa-solid ${type==='success'?'fa-check-circle':'fa-info-circle'}"></i> <span class="font-bold text-sm">${msg}</span>`;
      container.appendChild(toast);
      setTimeout(()=>{ toast.style.opacity='0'; setTimeout(()=>toast.remove(),500); },3000);
    },
    // Makes the app's actual storage backend impossible to miss or misremember,
    // instead of the previous approach (a toast that vanishes after 3 seconds
    // and is never shown again). Two parts:
    //  1) A permanent line in Settings stating exactly which backend is
    //     currently active - check this first whenever something looks like
    //     data went missing, since a backend switch (not deletion) is the
    //     most common cause.
    //  2) A banner pinned to the top of the screen for the WORST case only
    //     (no durable storage at all - pure in-memory, guaranteed to lose
    //     everything on refresh) that stays up all session, unlike a toast.
    renderStorageStatus(){
      const indicator = document.getElementById('storage-backend-indicator');
      const banner = document.getElementById('storage-fail-banner');
      const bannerText = document.getElementById('storage-fail-banner-text');
      const usingRemote = PersistentStore.useRemote;
      const usingMemoryOnly = !usingRemote && safeStorage.__isFallback;
      const writeDegraded = !usingRemote && !usingMemoryOnly && safeStorage.__writeDegraded;
      if(indicator){
        if(usingRemote){
          indicator.className = 'flex items-center gap-3 p-4 rounded-2xl border-2 text-sm font-semibold bg-emerald-50 dark:bg-emerald-900/20 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400';
          indicator.innerHTML = '<i class="fa-solid fa-circle-check text-lg"></i><div><div>Storage: Platform Persistent Storage</div><div class="text-xs font-normal opacity-80 mt-0.5">Your data is saved here and should be available wherever this app is opened under your account.</div></div>';
        } else if(usingMemoryOnly){
          indicator.className = 'flex items-center gap-3 p-4 rounded-2xl border-2 text-sm font-semibold bg-red-50 dark:bg-red-900/20 border-red-300 dark:border-red-800 text-red-700 dark:text-red-400';
          indicator.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-lg"></i><div><div>Storage: Temporary (in-memory) only — NOTHING will be saved</div><div class="text-xs font-normal opacity-80 mt-0.5">Reason: ${safeStorage.__reason}. Export a backup now via the button below before closing this page.</div></div>`;
        } else if(writeDegraded){
          indicator.className = 'flex items-center gap-3 p-4 rounded-2xl border-2 text-sm font-semibold bg-amber-50 dark:bg-amber-900/20 border-amber-300 dark:border-amber-800 text-amber-700 dark:text-amber-400';
          indicator.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-lg"></i><div><div>Storage: Browser Local Storage — nearly full</div><div class="text-xs font-normal opacity-80 mt-0.5">Your EXISTING saved data is safe and still loads normally. But a recent save attempt failed (${safeStorage.__writeReason}), so brand-new changes may not stick. Export a backup, then free up space (e.g. remove a large profile photo) or clear old records.</div></div>`;
        } else {
          indicator.className = 'flex items-center gap-3 p-4 rounded-2xl border-2 text-sm font-semibold bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-400';
          indicator.innerHTML = '<i class="fa-solid fa-hard-drive text-lg"></i><div><div>Storage: Browser Local Storage</div><div class="text-xs font-normal opacity-80 mt-0.5">Data is saved to THIS browser only, tied to this exact file/page. It will not carry over if you open a different copy of this file, a different browser, or a different device. Export regular backups as a safety net.</div></div>';
        }
      }
      if(banner){
        if(usingMemoryOnly){
          banner.className = 'fixed top-0 left-0 right-0 z-[120] bg-red-600 text-white text-sm font-bold text-center py-2 px-4 no-print flex items-center justify-center gap-3 flex-wrap';
          if(bannerText) bannerText.textContent = 'Storage is blocked here — nothing saves automatically. Import your last backup, work, then download a new one before closing.';
        } else if(writeDegraded){
          banner.className = 'fixed top-0 left-0 right-0 z-[120] bg-amber-500 text-white text-sm font-bold text-center py-2 px-4 no-print flex items-center justify-center gap-3 flex-wrap';
          if(bannerText) bannerText.textContent = 'Storage is nearly full — your existing data is safe, but new changes may not save. Export a backup and free up space.';
        } else {
          banner.classList.add('hidden');
          return;
        }
        banner.classList.remove('hidden');
      }
    },
    confirmDialog(message){
      return new Promise((resolve)=>{
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:200;background:rgba(15,23,42,.6);display:flex;align-items:center;justify-content:center;padding:16px;';
        overlay.innerHTML = `<div style="background:#fff;border-radius:20px;max-width:360px;width:100%;padding:24px;box-shadow:0 20px 60px rgba(0,0,0,.3);">
          <p style="font-size:14px;font-weight:600;color:#0f172a;margin:0 0 20px 0;line-height:1.5;">${message}</p>
          <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button id="confirm-cancel-btn" style="padding:10px 18px;border-radius:10px;border:none;background:#e2e8f0;color:#1a1a2e;font-weight:700;cursor:pointer;">Cancel</button>
            <button id="confirm-ok-btn" style="padding:10px 18px;border-radius:10px;border:none;background:#dc2626;color:#fff;font-weight:700;cursor:pointer;">Confirm</button>
          </div>
        </div>`;
        document.body.appendChild(overlay);
        const cleanup = (result)=>{ overlay.remove(); resolve(result); };
        overlay.querySelector('#confirm-cancel-btn').onclick = ()=>cleanup(false);
        overlay.querySelector('#confirm-ok-btn').onclick = ()=>cleanup(true);
        overlay.addEventListener('click',(e)=>{ if(e.target===overlay) cleanup(false); });
      });
    }
  },

  profile: {
    render(){
      const p = App.state.profile;
      Object.keys(p).forEach(key=>{ const el = document.getElementById(key); if(el && el.tagName!=='undefined') { if(el.type!=='file') el.value = p[key]||''; } });
      const fullName = `${p.firstName} ${p.lastName}`.trim() || 'Health Vault User';
      document.getElementById('display-name').innerText = fullName;
      document.getElementById('sidebar-name').innerText = fullName;
      const age = p.dob ? Math.floor((new Date() - new Date(p.dob))/31557600000) : '--';
      document.getElementById('display-age-gender').innerText = `${age} years old • ${p.gender||'--'}`;
      document.getElementById('display-blood').innerText = p.bloodType || '--';
      document.getElementById('display-bmi').innerText = p.bmi ? p.bmi.toFixed(1) : '--';
      const initials = ((p.firstName[0]||'') + (p.lastName[0]||'')) || 'U';
      document.getElementById('sidebar-initials').innerText = initials;
      document.getElementById('header-initials').innerText = initials;
      if(p.photo){ document.getElementById('profile-preview').src = p.photo; document.getElementById('profile-preview').classList.remove('hidden'); document.getElementById('profile-placeholder').classList.add('hidden'); }
      const bmiInd = document.getElementById('bmi-indicator');
      if(p.bmi < 18.5) bmiInd.className = 'h-3 w-3 rounded-full bg-blue-400';
      else if(p.bmi < 25) bmiInd.className = 'h-3 w-3 rounded-full bg-emerald-400';
      else if(p.bmi < 30) bmiInd.className = 'h-3 w-3 rounded-full bg-amber-400';
      else bmiInd.className = 'h-3 w-3 rounded-full bg-red-400';
    },
    save(){
      const p = App.state.profile;
      const fields = ['firstName','middleName','lastName','dob','gender','bloodType','address','city','state','zip','phone','emergencyName','emergencyPhone','emergencyAddress','emergencyEmail','insurance','heightRaw','weightRaw','weightUnit','cardNum'];
      fields.forEach(f=>{ const el = document.getElementById(f); if(el) p[f] = el.value; });
      let hCm = 0;
      const hNormalized = (p.heightRaw||'').trim().replace(/[\u2018\u2019]/g,"'").replace(/[\u201C\u201D]/g,'"');
      const hRaw = hNormalized.toLowerCase();
      if(hRaw.includes("'")){ const parts = hRaw.split("'"); const feet = parseFloat(parts[0])||0; const inches = parseFloat((parts[1]||'').replace(/["'\s]/g,''))||0; hCm = (feet*30.48)+(inches*2.54); }
      else if(hRaw.includes('cm')){ hCm = parseFloat(hRaw); }
      else if(hRaw.includes('m')){ hCm = parseFloat(hRaw) * 100; }
      else if(hRaw){ hCm = parseFloat(hRaw) * (parseFloat(hRaw) < 3 ? 100 : 1); }
      p.heightCm = hCm;
      const wVal = parseFloat(p.weightRaw);
      p.weightKg = p.weightUnit==='lbs' ? wVal*0.453592 : wVal;
      if(p.heightCm > 0 && p.weightKg > 0) p.bmi = p.weightKg / Math.pow(p.heightCm/100, 2);
      p.homeAddr = p.address;
      p.providerOneNumber = p.cardNum;
      if(!p.createdAt) p.createdAt = new Date().toISOString();
      p.updatedAt = new Date().toISOString();
      App.data.save().then(ok=>{ if(!ok){ App.ui.toast('Warning: profile may not have saved — check your connection and try again.','error'); } });
      this.render();
      App.dashboard.render();
      App.ui.toast('Profile updated successfully!');
    },
    handlePhoto(e){
      const file = e.target.files[0];
      if(!file) return;
      if(file.size > 2*1024*1024) return App.ui.toast('Max size 2MB','error');
      const reader = new FileReader();
      reader.onload = (ev)=>{ App.state.profile.photo = ev.target.result; App.data.save(); App.profile.render(); };
      reader.readAsDataURL(file);
    }
  },

  vitals: {
    add(e){
      e.preventDefault();
      const fd = new FormData(e.target);
      const entry = Object.fromEntries(fd.entries());
      const sys = parseInt(entry.systolic), dia = parseInt(entry.diastolic);
      entry.pulsePressure = sys - dia;
      entry.map = Math.round(dia + (1/3*entry.pulsePressure));
      entry.id = Date.now();
      App.state.vitals.unshift(entry);
      App.state.vitals.sort((a,b)=> new Date(b.date+' '+b.time) - new Date(a.date+' '+a.time));
      App.data.save().then(ok=>{ if(ok) App.ui.toast('Reading saved'); });
      App.ui.closeModal();
      this.render(); App.dashboard.render(); e.target.reset();
    },
    delete(id){ if(confirm('Delete this reading?')){ App.state.vitals = App.state.vitals.filter(v=>v.id!==id); App.data.save(); this.render(); App.dashboard.render(); } },
    render(filter=''){
      const container = document.getElementById('vitals-log-body'); container.innerHTML = '';
