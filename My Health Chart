    calculateAudit(){
      const r = this.getSectionAnswers('audit',10); const display = document.getElementById('audit-score-display');
      document.getElementById('audit-score').innerText = r.sum;
      let risk, action, cls;
      if(r.sum===0){ risk='No problems reported'; action='Encouragement and education'; cls='sb-risk-none'; }
      else if(r.sum<=7){ risk='Low risk'; action='Alcohol education'; cls='sb-risk-none'; }
      else if(r.sum<=15){ risk='Moderate risk'; action='Brief intervention'; cls='sb-risk-moderate'; }
