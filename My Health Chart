        else if(v.systolic>=130||v.diastolic>=80) bpColor='bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400';
        tr.innerHTML = `<td class="px-6 py-4"><div class="font-bold">${App.formatDate(v.date)}</div><div class="text-[10px] text-slate-400 uppercase">${v.time}</div></td>
