          <td class="px-6 py-4 text-center"><div class="font-bold">${v.heartRate} <span class="text-[10px] text-slate-400 font-normal">BPM</span></div><div class="font-bold text-cyan-500">${v.spo2}% <span class="text-[10px] text-slate-400 font-normal italic">O2</span></div></td>
