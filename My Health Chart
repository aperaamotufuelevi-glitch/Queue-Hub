/* Fallback so these specific overlay/modal containers can never be stuck visible
   and block the page, even if the Tailwind CDN fails to load. Scoped to just these
   IDs (not the generic .hidden class) so it never fights Tailwind's own responsive
   "hidden ... lg:flex" style utilities used elsewhere (e.g. the desktop sidebar). */
#loading-overlay.hidden, #modal-overlay.hidden, #formModal.hidden, #mobile-more-drawer.hidden{
  display:none !important;
}


/* ===== Transportation module (namespaced) ===== */
#tab-rides, #tab-logs {
  --tprimary:#1e3a5f; --tprimary-light:#2a4a73; --taccent:#ffd700; --tdanger:#dc2626; --tsuccess:#16a34a; --twarning:#f59e0b;
}
.tr-card{background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:16px;overflow:hidden;border:1px solid #e2e8f0}
.dark .tr-card{background:#1e293b;border-color:#334155}
.tr-card-header{background:var(--tprimary,#1e3a5f);color:#fff;padding:12px 16px;font-weight:700;display:flex;justify-content:space-between;align-items:center;font-size:15px}
.tr-card-body{padding:16px}
.tr-btn{padding:8px 16px;border:none;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
.tr-btn-primary{background:#1e3a5f;color:#fff}
.tr-btn-primary:hover{background:#2a4a73}
.tr-btn-success{background:#16a34a;color:#fff}
.tr-btn-danger{background:#dc2626;color:#fff}
.tr-btn-secondary{background:#e2e8f0;color:#1a1a2e}
.tr-btn-sm{padding:5px 10px;font-size:12px}
.tr-status-pill{padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600;cursor:pointer;border:2px solid transparent}
.tr-status-pill.active{border-color:#1e3a5f}
.tr-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.tr-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
