/* Print */
@media print{
  @page{size:letter;margin:0}
  *{box-sizing:border-box !important}
  html,body{background:#fff !important;margin:0 !important;padding:0 !important;overflow:visible !important;-webkit-print-color-adjust:exact !important;print-color-adjust:exact !important}
  #sidebar,#loading-overlay,#toast-container,header,nav,#mobile-more-drawer,#modal-overlay,main,aside,.no-print{display:none !important}
  #print-area{display:block !important;position:static !important;width:100% !important;max-width:100% !important;height:auto !important;min-height:100% !important;overflow:visible !important;background:#fff !important;margin:0 !important;padding:0 !important}
  #print-area *{visibility:visible !important;opacity:1 !important}
  #print-area canvas{display:block !important;max-width:100% !important;height:auto !important}
  #print-area img,#print-area table{max-width:100% !important}
  #print-area table{table-layout:fixed !important;width:100% !important}
  #print-area td,#print-area th{word-wrap:break-word !important;overflow-wrap:break-word !important}
  table{page-break-inside:auto}
  tr{page-break-inside:avoid;page-break-after:auto}
  thead{display:table-header-group}
  /* Every printed page is one of these, sized to exactly one sheet of
     Letter paper (@page above matches). Because each page is its own
     fixed-size, position:relative box - not a point in a continuously
     flowing document - the .print-page-footer inside it can be
     position:absolute against ITS OWN bottom edge. That is what makes the
     footer land in the same spot on every single page, whether that
     page's body content fills it or is a single short line: the footer's
     position is anchored to the page box itself, never to where the
     content above it happens to end, so it can't drift or get skipped.
     overflow:hidden guards against a page's content secretly running
     long and spilling into - or past - the footer band; callers are
     responsible for keeping each page's content within one sheet (the
     report builder below chunks any list that could grow long, like
     rides or screenings, into multiple pages rather than one tall one). */
  .print-page{position:relative;width:8.5in;height:11in;box-sizing:border-box;padding:.3in .3in 1.25in .3in;overflow:hidden;page-break-after:always;page-break-inside:avoid;color:#1a1a1a;background:#fff;font-family:system-ui,-apple-system,sans-serif}
  .print-page:last-child{page-break-after:auto}
