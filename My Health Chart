      // statuses are deliberately kept in separate columns and are never
      // combined into one value.
      // ============================================================
      const MED_TABLE_COLS = 'grid-template-columns:1.7fr .8fr 2.6fr 1fr 1.1fr 1fr;';
      const medTableHeaderHTML = `<div style="display:grid;${MED_TABLE_COLS}gap:6px;padding:6px 8px;background:#1e40af;color:#fff;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;">
        <div>Medication</div><div>Dose</div><div>Directions</div><div>Physician</div><div>Insurance</div><div>Refill</div>
      </div>`;
      const medHeadingHTML = `<h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:6px;margin-bottom:2px;">Active Medications</h1>
        <p style="font-size:9px;color:#64748b;margin:0 0 8px 0;">Active Medications: ${App.state.medications.length}</p>
        ${medTableHeaderHTML}`;
      const medRowHTML = (m)=>{
        const meta = App.meds.STATUS_META[m.refillStatus||'none'] || App.meds.STATUS_META.none;
        const insMeta = App.meds.INSURANCE_META[m.insuranceStatus||''] || App.meds.INSURANCE_META[''];
        // Physician column shows the actual doctor linked to this medication.
        // Prefers the name SNAPSHOTTED at selection time (m.doctorName) -
        // this is what makes the link immune to the doctor record later
        // being deleted/recreated (which would give it a new id and break
        // an id-only reference). Falls back to a live id lookup only for
        // medications linked before this snapshot existed.
        const liveDoc = m.doctorId ? App.state.doctors.find(d=>String(d.id)===String(m.doctorId)) : null;
        const doctorName = m.doctorName || (liveDoc ? liveDoc.name : '');
        const doctorLabel = doctorName ? 'Dr. '+doctorName : 'Not Specified';
        return `<div style="display:grid;${MED_TABLE_COLS}gap:6px;padding:6px 8px;border-bottom:1px solid #e2e8f0;font-size:9px;color:#1a1a1a;align-items:start;">
          <div style="font-weight:700;">${m.name}</div>
          <div>${m.dose||'--'}</div>
          <div>${m.frequency||'--'}${m.purpose?`<div style="font-size:8px;color:#64748b;margin-top:1px;">${m.purpose}</div>`:''}</div>
          <div>${doctorLabel}</div>
          <div>${insMeta.label || 'Unknown'}</div>
          <div>${meta.label}${m.receivedDate?`<div style="font-size:8px;color:#64748b;margin-top:1px;">Received: ${App.formatDateShort(m.refillDate||m.receivedDate)}</div>`:''}${m.nextRefillDate?`<div style="font-size:8px;color:#64748b;margin-top:1px;">Next Refill: ${App.formatDateShort(m.nextRefillDate)}</div>`:''}</div>
        </div>`;
      };
      const medChunks = this.paginateBySize(
        App.state.medications,
        medRowHTML,
        medHeadingHTML,
        null // full-width single column - no paired Patient Assessment box on this section
      );
      medChunks.forEach((chunk, ci)=>{
        const heading = ci>0
          ? `<h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:6px;margin-bottom:2px;">Active Medications (continued)</h1>${medTableHeaderHTML}`
          : medHeadingHTML;
        pages.push(`<div style="padding:16px;box-sizing:border-box;">
        ${heading}
        <div>${chunk.length? chunk.map(medRowHTML).join('') : '<p style="font-size:10px;color:#94a3b8;padding:8px;">No active medications logged.</p>'}</div>
      </div>`);
      });

      // Page: Health Analytics (period overview + charts + assessments)
      pages.push(`<div style="padding:16px;box-sizing:border-box;">${this.healthAnalyticsHTML()}</div>`);

      // Page: Conditions & Allergies
      pages.push(`<div style="padding:16px;box-sizing:border-box;">
        <h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:8px;">Conditions and Allergies</h1>
        <div style="margin-bottom:16px;"><h3 style="font-size:16px;font-weight:900;color:#064e3b;margin:16px 0 8px 0;border-left:3px solid #10b981;padding-left:8px;text-transform:uppercase;">Active Health Problems</h3>
          <table style="width:100%;border-collapse:collapse;font-size:9px;table-layout:fixed;"><tr style="background:#ecfdf5;"><th style="padding:6px;text-align:left;font-size:8px;text-transform:uppercase;color:#047857;width:26%;">Problem / Condition</th><th style="padding:6px;text-align:left;font-size:8px;text-transform:uppercase;color:#047857;width:18%;">Codes</th><th style="padding:6px;text-align:left;font-size:8px;text-transform:uppercase;color:#047857;width:12%;">Priority</th><th style="padding:6px;text-align:left;font-size:8px;text-transform:uppercase;color:#047857;width:20%;">Noted - Resolved</th><th style="padding:6px;text-align:left;font-size:8px;text-transform:uppercase;color:#047857;width:24%;">Last Modified</th></tr>
          ${App.state.conditions.length? App.state.conditions.map(c=>{
            const codes = [c.icd10?('ICD-10-CM: '+c.icd10):'', c.icd9?('ICD-9-CM: '+c.icd9):''].filter(Boolean).join('<br>') || '--';
            const lastMod = [c.lastModifiedDate?App.formatDate(c.lastModifiedDate):'', c.lastModifiedBy?('by Dr. '+c.lastModifiedBy):''].filter(Boolean).join(' ') || '--';
            const notedLabel = (!c.date || c.date==='Unknown') ? 'Unknown' : App.formatDate(c.date);
            const resolvedLabel = (!c.resolvedDate || c.resolvedDate==='Present') ? 'Present' : App.formatDate(c.resolvedDate);
            return `<tr><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;"><b>${c.name}</b></td><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;color:#475569;">${codes}</td><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;">${c.priority||'--'}</td><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;">${notedLabel} - ${resolvedLabel}</td><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;color:#475569;">${lastMod}</td></tr>`;
          }).join('') : '<tr><td colspan="5" style="padding:6px;text-align:center;color:#94a3b8;">No active problems logged.</td></tr>'}</table></div>
        <div><h3 style="font-size:16px;font-weight:900;color:#064e3b;margin:0 0 8px 0;border-left:3px solid #10b981;padding-left:8px;text-transform:uppercase;">Allergies & Reactions</h3>
          <table style="width:100%;border-collapse:collapse;font-size:10px;table-layout:fixed;"><tr style="background:#ecfdf5;"><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;color:#047857;width:50%;">Allergen</th><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;color:#047857;width:25%;">Severity</th><th style="padding:6px;text-align:left;font-size:9px;text-transform:uppercase;color:#047857;width:25%;">Date Identified</th></tr>
          ${App.state.allergies.length? App.state.allergies.map(a=>`<tr><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;font-weight:700;color:#be123c;">${a.name}</td><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;font-weight:700;">${a.severity}</td><td style="padding:4px 6px;border-bottom:1px solid #d1fae5;">Logged</td></tr>`).join('') : '<tr><td colspan="3" style="padding:6px;text-align:center;color:#94a3b8;">No allergies logged.</td></tr>'}</table></div>
      </div>`);

      // Pages: Doctor Directory (+ Emergency Contact Info + Patient
      // Assessment appended after the LAST doctor). Uses the same
      // measurement-based pagination as Active Medications so a long
      // directory (many doctors, or doctors with multi-line specialty
      // text) automatically continues onto additional pages instead of
      // overflowing past the reserved footer space and overlapping the
      // disclaimer.
      const DOC_TABLE_COLS = 'grid-template-columns:1.3fr 1.1fr 1.3fr 1.4fr .9fr;';
      const docTableHeaderHTML = `<div style="display:grid;${DOC_TABLE_COLS}gap:6px;padding:8px;background:#1e40af;color:#fff;font-size:9px;font-weight:700;text-transform:uppercase;">
        <div>Doctor Name</div><div>Specialty</div><div>Clinic</div><div>Address</div><div>Contact</div>
      </div>`;
      const docHeadingHTML = `<h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:8px;margin-bottom:8px;">Doctor Directory</h1>${docTableHeaderHTML}`;
      const doctorRowHTML = (d,i)=>`<div style="display:grid;${DOC_TABLE_COLS}gap:6px;padding:8px;border-bottom:1px solid #dbeafe;font-size:10px;background:${i%2===0?'#fff':'#eff6ff'};align-items:start;">
        <div style="font-weight:700;">${d.title||'Dr.'} ${d.name}</div>
        <div>${d.specialty||''}</div>
        <div style="color:#475569;">${d.clinic||'Not specified'}</div>
        <div style="color:#64748b;">${d.address||'Not provided'}</div>
        <div style="font-weight:700;">${d.phone||'—'}</div>
      </div>`;
      if(App.state.doctors.length){
        const docChunks = this.paginateBySize(App.state.doctors, doctorRowHTML, docHeadingHTML, null);
        docChunks.forEach((chunk, ci)=>{
          const heading = ci>0
            ? `<h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:8px;margin-bottom:8px;">Doctor Directory (continued)</h1>${docTableHeaderHTML}`
            : docHeadingHTML;
          pages.push(`<div style="padding:16px;box-sizing:border-box;">
        ${heading}
        <div>${chunk.map(doctorRowHTML).join('')}</div>
      </div>`);
        });
      } else {
        pages.push(`<div style="padding:16px;box-sizing:border-box;">
        <h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:8px;">Doctor Directory</h1>
        <div style="background:#f8fafc;padding:24px;border-radius:12px;text-align:center;border:2px dashed #cbd5e1;margin-top:12px;"><p style="font-size:14px;color:#94a3b8;margin:0;">No doctors have been added to the directory.</p></div>
      </div>`);
      }

      if(includeRides === true && App.state.rides.length){
        // Ride table itself is chunked at 18 rows/page - a plain table row is
        // compact, but this report page also carries page padding + a
        // heading, so 18 keeps real margin against the fixed page height.
        this.chunkArray(App.state.rides, 18).forEach((chunk, ci)=>{
          pages.push(`<div style="padding:16px;box-sizing:border-box;">
            <h1 style="font-size:16px;font-weight:900;color:#1e3a8a;text-transform:uppercase;border-bottom:2px solid #1e3a8a;padding-bottom:8px;">Transportation History${ci>0?' (continued)':''}</h1>
            <table style="width:100%;border-collapse:collapse;font-size:10px;table-layout:fixed;margin-top:12px;"><thead><tr style="background:#1e3a5f;color:#ffd700;"><th style="padding:6px;text-align:left;">Date</th><th style="padding:6px;text-align:left;">Patient</th><th style="padding:6px;text-align:left;">Provider</th><th style="padding:6px;text-align:left;">Pick-Up</th><th style="padding:6px;text-align:left;">Drop-Off</th><th style="padding:6px;text-align:left;">Status</th></tr></thead><tbody>
            ${chunk.map((r,i)=>`<tr style="background:${i%2===0?'#fff':'#f1f5f9'};"><td style="padding:6px;border-bottom:1px solid #e2e8f0;">${App.formatDateShort(r.apptDate)}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;">${r.name}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;">${r.provider||'-'}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;font-size:9px;">${r.puAddr||'-'}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;font-size:9px;">${r.doAddr||'-'}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;text-transform:uppercase;font-weight:700;">${r.status}</td></tr>`).join('')}
            </tbody></table>
            ${ci===0?'<p style="font-size:9px;color:#94a3b8;margin:10px 0 0 0;font-style:italic;">Full ride detail sheets follow, one per page.</p>':''}
          </div>`);
        });
        App.state.rides.forEach(r=> pages.push(this.rideDetailBlockHTML(r)));
      }
      if(includeScreenings !== false && App.state.screenings.length){
        const SD = App.screening.scoreDetail;
        // Finds the option label the user actually selected for a given
        // question, by matching the saved score back to that specific
        // question's own options (each question's own scores are unique,
        // so this is an unambiguous lookup). Falls back honestly to "Not
        // answered" rather than guessing, for any question missing from an
        // older screening saved before answers were captured.
        const findAnswerLabel = (item, score) => {
          if(score === undefined || score === null) return 'Not answered';
          const opt = item.opts.find(([,s])=>s===score);
          return opt ? opt[0] : 'Not answered';
        };
        const QA_SECTIONS = [
          {prefix:'audit', label:'AUDIT (Alcohol Use)', questions:App.screening.AUDIT_Q},
          {prefix:'dast', label:'DAST-10 (Drug Use)', questions:App.screening.DAST_Q},
          {prefix:'phq', label:'PHQ-9 (Depression)', questions:App.screening.PHQ_Q},
          {prefix:'gad', label:'GAD-7 (Anxiety)', questions:App.screening.GAD_Q}
        ];
        // Plain-language synthesis of the four ALREADY-COMPUTED severity
        // levels for this screening - restates existing risk labels, does
        // not introduce any new clinical judgment.
        const buildInterpretation = (s) => [
          `Alcohol use (AUDIT): ${SD('audit', s.auditScore).risk}.`,
          `Drug use (DAST-10): ${SD('dast', s.dastScore).risk}.`,
          `Depression (PHQ-9): ${SD('phq', s.phqScore).risk}.`,
          `Anxiety (GAD-7): ${SD('gad', s.gadScore).risk}.`
        ].join(' ');
        const summaryBlockHTML = (s) => {
          const rows = [
            ['AUDIT (Alcohol Use)', s.auditScore, SD('audit', s.auditScore)],
            ['DAST-10 (Drug Use)', s.dastScore, SD('dast', s.dastScore)],
            ['PHQ-9 (Depression)', s.phqScore, SD('phq', s.phqScore)],
            ['GAD-7 (Anxiety)', s.gadScore, SD('gad', s.gadScore)]
          ];
          const flagsHtml = (s.suicideRisk || s.clinicalSignificant) ? `<div style="background:#fef2f2;border:2px solid #fecaca;border-radius:8px;padding:10px 12px;margin-bottom:10px;">
              ${s.suicideRisk?'<p style="margin:0 0 4px 0;font-weight:900;color:#991b1b;font-size:11px;">⚠ SUICIDE RISK — positive response on PHQ-9 item 9 (thoughts of self-harm). Warrants immediate clinical follow-up.</p>':''}
              ${s.clinicalSignificant?'<p style="margin:0;font-weight:900;color:#92400e;font-size:11px;">⚠ CLINICALLY SIGNIFICANT — PHQ-9 and/or GAD-7 score indicates a clinically significant problem; initial clinical assessment recommended.</p>':''}
            </div>` : '';
          return `<div style="border:2px solid #1e3a5f;border-radius:10px;overflow:hidden;margin-bottom:12px;">
            <div style="background:#1e3a5f;padding:10px 14px;font-weight:900;font-size:13px;color:#ffd700;">Screening Date: ${App.formatDate(s.date)}</div>
            <div style="padding:12px;background:#fff;">
              ${flagsHtml}
              <table style="width:100%;border-collapse:collapse;font-size:10px;table-layout:fixed;">
                <thead><tr style="background:#f1f5f9;"><th style="padding:6px;text-align:left;width:26%;color:#1a1a1a;">Assessment</th><th style="padding:6px;text-align:center;width:10%;color:#1a1a1a;">Score</th><th style="padding:6px;text-align:left;width:24%;color:#1a1a1a;">Severity / Risk</th><th style="padding:6px;text-align:left;width:40%;color:#1a1a1a;">Recommended Action</th></tr></thead>
                <tbody>${rows.map(([name,score,d],i)=>`<tr style="background:${i%2===0?'#fff':'#f8fafc'};"><td style="padding:6px;border-bottom:1px solid #e2e8f0;font-weight:600;color:#1a1a1a;">${name}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;text-align:center;font-weight:700;color:#1a1a1a;">${score}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;color:#1a1a1a;">${d.risk}</td><td style="padding:6px;border-bottom:1px solid #e2e8f0;color:#1a1a1a;">${d.action}</td></tr>`).join('')}</tbody>
              </table>
              <div style="margin-top:10px;padding-top:10px;border-top:1px solid #e2e8f0;"><p style="font-size:9px;font-weight:900;text-transform:uppercase;color:#1e3a5f;margin:0 0 4px 0;">Interpretation</p><p style="font-size:10px;color:#1a1a1a;margin:0;line-height:1.5;">${buildInterpretation(s)}</p></div>
            </div>
          </div>`;
        };
        App.state.screenings.slice().reverse().forEach((s, si)=>{
          const qaRows = [];
          QA_SECTIONS.forEach(sec=>{
            sec.questions.forEach((item,i)=>{
              const qid = sec.prefix+'-'+(i+1);
              const score = (s.answers||{})[qid];
              qaRows.push({ section: sec.label, number: i+1, question: item.q, answer: findAnswerLabel(item, score), danger: !!item.danger });
            });
          });
          // Compact table layout (grid-based, not a real <table>, so each
          // row remains independently measurable for paginateBySize) -
          // fits far more questions per page than the previous stacked
          // format, which left trailing pages sparse.
