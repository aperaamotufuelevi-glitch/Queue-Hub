  meds: {
    // ============================================================
    // Refill status vocabulary + display metadata - the SINGLE source of
    // truth used by BOTH the Dashboard "Refill Alerts" card and the
    // Medications tab, so their wording, colors, and available actions can
    // never drift apart. Anywhere either screen used to hard-code its own
    // copy of these labels, it now calls into this table instead.
    // ------------------------------------------------------------
    // 'received' is a new terminal state a medication can be moved to
    // directly from ANY other state via markReceived() below - this is
    // the "select medication received" option that used to only be
    // reachable after first going through requested -> pending.
    // ============================================================
    STATUS_META: {
      none:      { label:'On Schedule',            badgeClass:'bg-slate-100 text-slate-600' },
      requested: { label:'Refill Requested',        badgeClass:'bg-amber-100 text-amber-700' },
      pending:   { label:'Pending Doctor Approval',  badgeClass:'bg-blue-100 text-blue-700' },
      received:  { label:'Received',                 badgeClass:'bg-emerald-100 text-emerald-700' }
    },
    statusLabel(status){ return (this.STATUS_META[status||'none']||this.STATUS_META.none).label; },
    // Same "single source of truth" pattern as STATUS_META above, for the
    // separate concept of insurance coverage status. Used by BOTH the
    // Medications tab card badge and the printed "Active Medications"
    // section so the wording/colors can't drift apart between them either.
    INSURANCE_META: {
      '':           { label:'', badgeClass:'' },
      covered:      { label:'Covered', badgeClass:'bg-emerald-100 text-emerald-700' },
      pending:      { label:'Insurance Pending', badgeClass:'bg-amber-100 text-amber-700' },
      not_covered:  { label:'Not Covered', badgeClass:'bg-rose-100 text-rose-700' }
    },
    insuranceLabel(status){ return (this.INSURANCE_META[status||'']||this.INSURANCE_META['']).label; },
    // Builds the actual action button(s) for one medication's current
    // refillStatus. Used by BOTH App.dashboard.render() (Refill Alerts) and
    // App.meds.render() (Medications tab) so the two screens always offer
    // the exact same choices for the exact same medication. "Mark as
    // Received" is included on every branch (not only when status is
    // 'pending') so a person can log a medication as received at any point
    // in the workflow, not just at the end of the request/pending chain.
    refillActionsHTML(med, size){
      const status = med.refillStatus || 'none';
      const sz = size || 'normal';
      const cls = sz==='sm' ? 'px-2.5 py-1.5 text-[11px]' : 'px-3 py-2 text-[11px]';
      const btn = (bg,hover,icon,label,onclick,title)=>`<button onclick="${onclick}" class="flex-1 flex items-center justify-center gap-1.5 ${cls} ${bg} ${hover} text-white rounded-lg font-bold" ${title?`title="${title}"`:''}><i class="fa-solid ${icon}"></i>${label}</button>`;
      const cancelBtn = `<button onclick="App.meds.setRefillStatus(${med.id},'none')" class="${cls} bg-slate-100 dark:bg-slate-700 text-slate-500 rounded-lg font-bold" title="Cancel"><i class="fa-solid fa-xmark"></i></button>`;
      let out = '';
      if(status==='none'){
        out += btn('bg-amber-600','hover:bg-amber-700','fa-file-prescription','Request Refill', `App.meds.setRefillStatus(${med.id},'requested')`);
      } else if(status==='requested'){
        out += btn('bg-blue-600','hover:bg-blue-700','fa-hourglass-half','Mark Pending Doctor', `App.meds.setRefillStatus(${med.id},'pending')`);
        out += cancelBtn;
      } else if(status==='pending'){
        out += cancelBtn;
      }
      // Always-available direct action - lets the medication be marked
      // received from ANY state (none / requested / pending) in one click,
      // instead of forcing the none -> requested -> pending -> received chain.
      if(status!=='received'){
        out += btn('bg-emerald-600','hover:bg-emerald-700','fa-check','Mark as Received', `App.meds.markReceived(${med.id})`);
      } else {
        out += `<button onclick="App.meds.setRefillStatus(${med.id},'none')" class="${cls} flex-1 flex items-center justify-center gap-1.5 bg-slate-100 dark:bg-slate-700 text-slate-500 rounded-lg font-bold" title="Undo — back to On Schedule"><i class="fa-solid fa-rotate-left"></i>Received — Reset</button>`;
      }
      return out;
    },
