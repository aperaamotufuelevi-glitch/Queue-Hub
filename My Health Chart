</style>
<script>
/* ============================================================
   safeStorage
   ------------------------------------------------------------
   FIX for "my data is gone" caused by a bug in THIS app's own
   detection logic (not a browser limitation): the previous version
   of this check tested storage health by WRITING a small test value.
   If real, existing saved data had grown close to this browser's
   storage quota, that tiny test write could fail with a quota error
   - and the old code treated ANY write failure as "storage is
   completely inaccessible," discarding the real localStorage object
   entirely and silently substituting an empty in-memory stand-in for
   BOTH reads and writes. Reading data does not consume quota - only
   growing it does - so an out-of-space condition should degrade
   WRITES only, while reads of already-saved data keep working
   normally. Conflating the two made perfectly intact, still-present
   data look "gone" the moment storage got close to full.

   Fix: probe accessibility with a READ (which cannot fail from being
   out of space), and track write failures separately and per-call
   rather than using one write failure to abandon localStorage
   altogether. `__isFallback` now means "localStorage is truly
   inaccessible, even for reads" (the only case where reads legitimately
   have nothing to fall back to). `__writeDegraded` means "reads still
   work and any previously-saved data is intact, but at least one
   recent write attempt failed (most commonly: storage is nearly
   full)" - a real but much less severe problem that should never by
   itself hide existing data.
   ============================================================ */
const safeStorage = (function(){
  let RealLS = null;
  try { RealLS = window.localStorage || null; } catch(e){ RealLS = null; }

  let hardBlocked = false;
  let hardBlockReason = '';
  if(RealLS){
    // A READ-only probe: cannot fail due to low storage space, only due to
    // localStorage being fundamentally inaccessible (fully sandboxed/disabled
    // context) - the only situation where falling back for reads too is
    // actually correct.
    try { RealLS.getItem('__uhs_probe__'); }
    catch(e){
      hardBlocked = true;
      hardBlockReason = (e && e.name) ? (e.name + (e.message ? ': ' + e.message : '')) : 'unknown error';
      RealLS = null;
    }
  } else {
    hardBlocked = true;
    hardBlockReason = 'localStorage is not available in this browser/context';
  }
  if(hardBlocked){
